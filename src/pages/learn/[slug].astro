---
// /learn/<slug>: one static page per lesson, from src/data/lessons.ts (titles and minutes from
// course.ts). Gated by functions/learn/_middleware.ts. "Mark as done" and the ticks are saved in
// this browser (src/components/learn/progress.ts).
import type { GetStaticPaths } from "astro";
import LearnLayout from "../../components/learn/LearnLayout.astro";
import LessonPlayer from "../../components/learn/LessonPlayer.astro";
import LessonList from "../../components/learn/LessonList.astro";
import Icon from "../../components/Icon.astro";
import { course } from "../../data/course";
import { lessons, modules, type Lesson } from "../../data/lessons";
import { whatsappLink } from "../../lib/whatsapp";

export const getStaticPaths = (() =>
  lessons.map((lesson, i) => ({
    params: { slug: lesson.slug },
    props: { lesson, prev: lessons[i - 1] ?? null, next: lessons[i + 1] ?? null },
  }))) satisfies GetStaticPaths;

interface Props {
  lesson: Lesson;
  prev: Lesson | null;
  next: Lesson | null;
}

const { lesson, prev, next } = Astro.props;
const total = lessons.length;
const moduleLessonCount = modules[lesson.moduleNumber - 1]!.lessons.length;
const question = whatsappLink(`Hi Urmi, I have a question about the lesson "${lesson.title}" in the ${course.title}.`);
---

<LearnLayout
  title={`${lesson.title} | ${course.title}`}
  description={`Lesson ${lesson.number} of ${total} in the ${course.title}: ${lesson.title}.`}
>
  <div class="container lesson" data-lesson-page={lesson.slug}>
    <div class="main">
      <nav class="crumbs" aria-label="Course">
        <a class="back" href="/learn"><Icon name="caret-left" /> All lessons</a>
        <span class="count">Lesson {lesson.number} of {total}</span>
      </nav>

      <LessonPlayer lesson={lesson} />

      <header class="head">
        <p class="module">Module {lesson.moduleNumber} · {lesson.moduleTitle}</p>
        <h1 class="title">{lesson.title}<span class="bindi"></span></h1>
        <p class="meta">
          <Icon name="clock" class="icon meta-clock" />
          {lesson.minutes} min
          <span aria-hidden="true">·</span>
          Lesson {lesson.numberInModule} of {moduleLessonCount} in this module
        </p>
      </header>

      <div class="actions" data-lesson-actions>
        <button
          type="button"
          class="btn btn-primary mark"
          aria-pressed="false"
          aria-label="Mark as done"
          data-mark-done
          hidden
        >
          <Icon name="check-circle" class="icon mark-icon" />
          <span data-mark-label>Mark as done</span>
        </button>
        {
          next ? (
            <a class="btn btn-secondary next" href={next.href} data-next>
              Next lesson
              <Icon name="arrow-right" />
            </a>
          ) : (
            <a class="btn btn-secondary next" href="/learn" data-next>
              All lessons
              <Icon name="arrow-right" />
            </a>
          )
        }
      </div>

      <section class="notes" aria-labelledby="notes-title">
        <div class="notes-head">
          <h2 id="notes-title" class="notes-title">Notes and resources</h2>
          <span class="chip">Demo</span>
        </div>
        <p class="notes-text">
          This is a placeholder in the demo. When the lesson is recorded, its notes and any downloads go here.
        </p>
        <a class="link-arrow ask" href={question} target="_blank" rel="noopener">
          <Icon name="whatsapp" />
          Ask Urmi about this lesson<span class="visually-hidden"> (opens WhatsApp)</span>
        </a>
      </section>

      <nav class="pager" aria-label="Previous and next lesson">
        {
          prev ? (
            <a class="page prev" href={prev.href} rel="prev" data-press>
              <span class="page-dir">
                <Icon name="caret-left" /> Previous
              </span>
              <span class="page-title">{prev.title}</span>
            </a>
          ) : (
            <a class="page prev" href="/learn" data-press>
              <span class="page-dir">
                <Icon name="caret-left" /> Course home
              </span>
              <span class="page-title">All lessons</span>
            </a>
          )
        }
        {
          next ? (
            <a class="page nextp" href={next.href} rel="next" data-press>
              <span class="page-dir">
                Next <Icon name="caret-right" />
              </span>
              <span class="page-title">{next.title}</span>
            </a>
          ) : (
            <a class="page nextp" href="/learn" data-press>
              <span class="page-dir">
                Finish <Icon name="caret-right" />
              </span>
              <span class="page-title">Back to your course</span>
            </a>
          )
        }
      </nav>
    </div>

    <aside class="aside" aria-labelledby="outline-title">
      <details class="outline" open data-outline>
        <summary class="outline-sum">
          <span class="outline-text">
            <span id="outline-title" class="outline-title">All lessons</span>
            <span class="outline-count"><span data-progress-done>0</span> of {total} done</span>
          </span>
          <span class="meter" data-progress-meter aria-hidden="true"><span></span></span>
          <Icon name="caret-down" class="icon outline-caret" />
        </summary>
        <div class="outline-body">
          <LessonList modules={modules} current={lesson.slug} compact />
        </div>
      </details>
    </aside>
  </div>
</LearnLayout>

<style>
  .lesson {
    display: grid;
    gap: var(--space-6);
    padding-top: var(--space-3);
  }

  .main {
    display: grid;
    gap: var(--space-5);
    min-width: 0;
  }

  /* ── Top row ── */
  .crumbs {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    font-size: var(--text-sm);
    font-weight: var(--weight-ui);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 2.75rem;
    margin-left: calc(var(--space-2) * -1);
    padding-inline: var(--space-2);
    color: var(--text);
    text-decoration: none;
    border-radius: var(--radius-pill);
  }

  .back:hover {
    background: var(--bg-soft);
  }

  .back :global(.icon) {
    width: 1.1em;
    height: 1.1em;
  }

  .count {
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  /* ── Title ── */
  .head {
    display: grid;
    gap: var(--space-2);
  }

  .module {
    font-size: var(--text-sm);
    font-weight: var(--weight-strong);
    color: var(--text-muted);
  }

  .title {
    font-size: var(--text-2xl);
    line-height: var(--leading-snug);
    letter-spacing: -0.025em;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-ui);
    color: var(--text-body);
    font-variant-numeric: tabular-nums;
  }

  .meta :global(.meta-clock) {
    width: 1.05em;
    height: 1.05em;
    color: var(--text-muted);
  }

  /* ── Mark as done + next. Phones: a bar at the bottom of the screen, in reach of the thumb. ── */
  .actions {
    display: flex;
    gap: var(--space-3);
  }

  .actions .btn {
    flex: 1 1 0;
    min-width: 0;
  }

  .mark[hidden] {
    display: none;
  }

  .mark :global(.mark-icon) {
    transition: transform var(--dur-base) var(--ease-out);
  }

  @media (prefers-reduced-motion: no-preference) {
    .mark[data-just-done] :global(.mark-icon) {
      animation: tick-pop 460ms cubic-bezier(0.34, 1.5, 0.5, 1);
    }

    @keyframes tick-pop {
      from {
        transform: scale(0.4);
      }
    }
  }

  @media (max-width: 47.99rem) {
    .actions {
      position: fixed;
      inset: auto 0 0;
      z-index: 20;
      padding: var(--space-3) var(--gutter) calc(var(--space-3) + env(safe-area-inset-bottom));
      background: var(--bg-glass);
      border-top: 1px solid var(--border);
      view-transition-name: lesson-actions;
    }

    /* Room under the page for the bar. */
    .lesson {
      padding-bottom: calc(var(--mobile-bar-h) + env(safe-area-inset-bottom));
    }
  }

  /* ── Notes ── */
  .notes {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .notes-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .notes-title {
    font-size: var(--text-lg);
    font-weight: var(--weight-strong);
    letter-spacing: -0.01em;
  }

  .chip {
    padding: 0.1rem 0.6rem;
    border-radius: var(--radius-pill);
    background: var(--bg-tint);
    color: var(--text);
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
  }

  .notes-text {
    font-size: var(--text-sm);
    color: var(--text-body);
    max-width: 40em;
  }

  .ask {
    min-height: 2.75rem;
    align-items: center;
  }

  /* ── Previous / next ── */
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .page {
    display: grid;
    align-content: start;
    gap: var(--space-1);
    min-height: 5rem;
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--text);
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .page:hover {
    border-color: var(--text);
  }

  .nextp {
    text-align: right;
  }

  .page-dir {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .nextp .page-dir {
    justify-self: end;
  }

  .page-dir :global(.icon) {
    width: 1.1em;
    height: 1.1em;
  }

  .page-title {
    font-weight: var(--weight-strong);
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  /* ── Outline ── */
  .outline {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg);
  }

  .outline-sum {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    min-height: 3.5rem;
    padding: var(--space-3) var(--space-4);
    cursor: pointer;
    list-style: none;
    border-radius: var(--radius-md);
  }

  .outline-sum::-webkit-details-marker {
    display: none;
  }

  .outline-text {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
  }

  .outline-title {
    font-weight: var(--weight-strong);
    color: var(--text);
  }

  .outline-count {
    font-size: var(--text-sm);
    font-weight: var(--weight-ui);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .outline-sum :global(.outline-caret) {
    grid-column: 2;
    grid-row: 1;
    color: var(--text-muted);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .outline[open] .outline-sum :global(.outline-caret) {
    transform: rotate(180deg);
  }

  /* Progress as a thin bar under the summary: scaleX only. */
  .meter {
    grid-column: 1 / -1;
    position: relative;
    height: 4px;
    border-radius: var(--radius-pill);
    background: var(--border-strong);
    overflow: hidden;
  }

  .meter > span {
    position: absolute;
    inset: 0;
    background: var(--bg-deep);
    transform-origin: left center;
    transform: scaleX(var(--progress, 0));
    transition: transform 420ms var(--ease-soft);
  }

  .outline-body {
    border-top: 1px solid var(--border);
    padding-bottom: var(--space-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .meter > span,
    .outline-sum :global(.outline-caret) {
      transition: none;
    }
  }

  /* ── Tablet ── */
  @media (min-width: 48rem) {
    .lesson {
      padding-top: var(--space-5);
    }

    .actions {
      justify-content: flex-start;
    }

    .actions .btn {
      flex: 0 0 auto;
    }

    .page {
      padding: var(--space-4) var(--space-5);
    }
  }

  /* ── Desktop: the lesson beside the course outline ── */
  @media (min-width: 64rem) {
    .lesson {
      grid-template-columns: minmax(0, 1fr) 21rem;
      align-items: start;
      column-gap: var(--space-7);
    }

    .aside {
      position: sticky;
      top: calc(var(--header-h) + var(--space-5));
      max-height: calc(100vh - var(--header-h) - var(--space-7));
      overflow: auto;
      overscroll-behavior: contain;
      border-radius: var(--radius-md);
    }
  }

  @media (min-width: 90rem) {
    .lesson {
      grid-template-columns: minmax(0, 1fr) 24rem;
      column-gap: var(--space-8);
    }
  }
</style>
