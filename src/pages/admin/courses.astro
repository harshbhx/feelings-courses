---
// Courses: every course (drafts, published, archived) from GET /api/admin/courses, with its web
// address, format, fee, status and students. "New course" asks for a title, web address and format,
// creates a draft (POST /api/admin/courses) and opens the editor.
import Admin from "../../layouts/Admin.astro";
import Icon from "../../components/Icon.astro";
---

<Admin
  title="Courses"
  active="courses"
  icons={["pencil-simple", "eye", "users-three", "book-open-text", "plus", "link-simple", "calendar-blank", "video-camera", "image"]}
>
  <header class="page-head">
    <div>
      <h1 class="page-title">Courses</h1>
      <p class="page-sub">Make a course, choose its web address, add lessons or batches, set the fee, then publish it.</p>
    </div>
    <div class="page-actions">
      <a class="btn btn-secondary" href="/catalog">
        <Icon name="storefront" />
        View catalog
      </a>
      <button class="btn btn-primary" type="button" data-new-course>
        <Icon name="plus" />
        New course
      </button>
    </div>
  </header>

  <div class="toolbar">
    <div class="segmented" role="group" aria-label="Show">
      <button type="button" aria-pressed="true" data-filter="all">All <span data-count="all"></span></button>
      <button type="button" aria-pressed="false" data-filter="published">Published <span data-count="published"></span></button>
      <button type="button" aria-pressed="false" data-filter="draft">Drafts <span data-count="draft"></span></button>
      <button type="button" aria-pressed="false" data-filter="archived">Archived <span data-count="archived"></span></button>
    </div>
  </div>

  <section class="crs" aria-label="Your courses" data-region>
    <div class="crs-head" aria-hidden="true">
      <span>Course</span>
      <span>Fee</span>
      <span>Status</span>
      <span>Students</span>
      <span></span>
    </div>
    <ul class="crs-list" data-list></ul>
  </section>
  <p class="visually-hidden" aria-live="polite" data-list-live></p>
</Admin>

<script>
  import "../../components/admin/client/courses";
</script>

<style is:global>
  .segmented [data-count] {
    color: var(--text-muted);
    font-weight: var(--weight-ui);
    font-variant-numeric: tabular-nums;
  }

  .crs-head {
    display: none;
  }

  .crs-list {
    list-style: none;
    display: grid;
    gap: var(--space-3);
  }

  .crs-item {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    grid-template-areas:
      "cover info"
      "actions actions";
    gap: var(--space-3) var(--space-4);
    padding: var(--space-4);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }

  .crs-cover-empty {
    display: grid;
    place-items: center;
    color: var(--maroon-800);
  }

  .crs-cover-empty .icon {
    width: 1.5rem;
    height: 1.5rem;
  }

  .crs-host {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-ui);
    overflow-wrap: anywhere;
  }

  .crs-host .icon {
    flex: none;
    width: 0.9rem;
    height: 0.9rem;
  }

  .crs-list > .state-li,
  .crs-region-state {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .crs-cover {
    grid-area: cover;
    width: 4.5rem;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-sm);
    background: var(--bg-tint);
    object-fit: cover;
  }

  .crs-info {
    grid-area: info;
    display: grid;
    align-content: start;
    gap: 0.3rem;
    min-width: 0;
  }

  .crs-title {
    color: var(--text);
    font-size: var(--text-base);
    font-weight: var(--weight-strong);
    letter-spacing: -0.01em;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .crs-tag {
    display: inline-block;
    margin-left: 0.35rem;
    padding: 0.05rem 0.45rem;
    border-radius: var(--radius-sm);
    background: var(--bg-soft);
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
    letter-spacing: 0;
    vertical-align: 0.1em;
    white-space: nowrap;
  }

  .crs-meta {
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-ui);
  }

  .crs-price {
    color: var(--text);
    font-weight: var(--weight-strong);
    font-variant-numeric: tabular-nums;
  }

  .crs-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-top: 0.15rem;
  }

  .crs-students {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-ui);
    font-variant-numeric: tabular-nums;
  }

  .crs-students .icon {
    width: 1rem;
    height: 1rem;
    color: var(--text-muted);
  }

  .crs-actions {
    grid-area: actions;
    display: flex;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
  }

  .crs-actions .btn {
    flex: 1 1 0;
  }

  /* The desktop-only cells. */
  .crs-cell-price,
  .crs-cell-status,
  .crs-cell-students {
    display: none;
  }

  .crs-foot {
    margin-top: var(--space-4);
  }

  @media (min-width: 64rem) {
    .crs {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-sm);
    }

    .crs-head,
    .crs-item {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 7rem 8rem 6rem 13rem;
      grid-template-areas: none;
      align-items: center;
      gap: var(--space-4);
      padding: var(--space-3) var(--space-5);
    }

    .crs-head {
      padding-block: var(--space-3);
      border-bottom: 1px solid var(--border);
      color: var(--text-muted);
      font-size: var(--text-xs);
      font-weight: var(--weight-strong);
    }

    .crs-list {
      gap: 0;
    }

    .crs-item {
      border: 0;
      border-radius: 0;
      box-shadow: none;
      background: none;
    }

    .crs-item + .crs-item {
      border-top: 1px solid var(--border);
    }

    .crs-main {
      display: flex;
      align-items: center;
      gap: var(--space-4);
      min-width: 0;
    }

    .crs-cover,
    .crs-info,
    .crs-actions {
      grid-area: auto;
    }

    .crs-cover {
      flex: none;
      width: 3.5rem;
    }

    .crs-line,
    .crs-meta .crs-price {
      display: none;
    }

    .crs-cell-price,
    .crs-cell-status,
    .crs-cell-students {
      display: block;
    }

    .crs-cell-price {
      color: var(--text);
      font-weight: var(--weight-strong);
      font-variant-numeric: tabular-nums;
    }

    .crs-cell-students {
      font-variant-numeric: tabular-nums;
    }

    .crs-actions {
      justify-content: flex-end;
      padding: 0;
      border: 0;
    }

    .crs-actions .btn {
      flex: none;
    }
  }

  /* On phones the row is a card: cover, words and status, then the two actions. */
  @media (max-width: 63.99rem) {
    .crs-main {
      display: contents;
    }
  }
</style>
