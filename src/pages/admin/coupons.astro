---
// Coupons: every code (GET /api/admin/coupons) with its discount, course, uses and dates; switch a
// code on or off in place, create and edit in a drawer, delete a code nobody has used. Prices are
// always worked out on the server at checkout (W2); this screen only manages the codes.
import Admin from "../../layouts/Admin.astro";
import Icon from "../../components/Icon.astro";
---

<Admin title="Coupons" active="coupons" icons={["copy", "pencil-simple", "trash", "ticket", "plus", "percent", "currency-inr"]}>
  <header class="page-head">
    <div>
      <h1 class="page-title">Coupons</h1>
      <p class="page-sub">Discount codes for your reels, stories and collaborations. One code per reel shows which one sells.</p>
    </div>
    <div class="page-actions">
      <button class="btn btn-primary" type="button" data-new>
        <Icon name="plus" />
        New coupon
      </button>
    </div>
  </header>

  <div class="toolbar">
    <div class="segmented" role="group" aria-label="Show">
      <button type="button" aria-pressed="true" data-filter="all">All <span data-n="all"></span></button>
      <button type="button" aria-pressed="false" data-filter="active">Running <span data-n="active"></span></button>
      <button type="button" aria-pressed="false" data-filter="stopped">Stopped <span data-n="stopped"></span></button>
    </div>
  </div>

  <section class="card" aria-labelledby="cpn-title">
    <h2 class="visually-hidden" id="cpn-title">Your codes</h2>
    <div data-region></div>
  </section>
</Admin>

<script>
  import "../../components/admin/client/coupons";
</script>

<style is:global>
  .segmented [data-n] {
    color: var(--text-muted);
    font-weight: var(--weight-ui);
    font-variant-numeric: tabular-nums;
  }

  .cpn-code {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-weight: var(--weight-strong);
    letter-spacing: 0.02em;
  }

  .cpn-actions {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-1);
  }

  .cpn-on {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  @media (max-width: 47.99rem) {
    .cpn-actions {
      grid-column: 1 / -1;
      justify-content: flex-start;
    }
  }
</style>
