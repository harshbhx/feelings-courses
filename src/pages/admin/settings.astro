---
// Settings (DEMO): the studio profile (read-only, from src/data/site.ts), payment mode, the course
// site's address, notification switches and "Reset demo data". Script:
// src/components/admin/settings/settings.ts.
import Admin from "../../layouts/Admin.astro";
import Icon from "../../components/Icon.astro";
import StudioProfile from "../../components/admin/settings/StudioProfile.astro";
import PaymentMode from "../../components/admin/settings/PaymentMode.astro";
import SiteDomain from "../../components/admin/settings/SiteDomain.astro";
import Notifications from "../../components/admin/settings/Notifications.astro";
import ResetDemo from "../../components/admin/settings/ResetDemo.astro";
---

<Admin title="Settings" active="settings">
  <header class="page-head">
    <div>
      <h1 class="page-title">Settings</h1>
      <p class="page-sub">Your studio details, payments, the course site's address and notifications.</p>
      <p class="demo-note">
        <Icon name="info" />
        Demo: nothing here changes the live site. Payments stay in test mode.
      </p>
    </div>
  </header>

  {/* Phones: one column in this order. From 80rem: two balanced columns. */}
  <div class="set-grid">
    <div class="set-col">
      <StudioProfile />
      <PaymentMode />
    </div>
    <div class="set-col">
      <SiteDomain />
      <Notifications />
      <ResetDemo />
    </div>
  </div>
</Admin>

<script>
  import "../../components/admin/settings/settings";
</script>

<style is:global>
  .set-grid,
  .set-col {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    min-width: 0;
  }

  @media (min-width: 48rem) {
    .set-grid,
    .set-col {
      gap: var(--space-5);
    }
  }

  @media (min-width: 80rem) {
    .set-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  .set-card {
    min-width: 0;
  }

  .set-body {
    display: grid;
    gap: var(--space-4);
  }

  .set-ic {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--bg-tint);
    color: var(--maroon-800);
  }

  .set-ic .icon {
    width: 1.25rem;
    height: 1.25rem;
  }

  /* ── Studio profile ── */
  .set-lock .icon {
    color: var(--text-muted);
  }

  .admin .textarea[readonly] {
    min-height: 0;
    resize: none;
    background: var(--bg-soft);
    color: var(--text-body);
    border-style: dashed;
  }

  .set-tnum {
    font-variant-numeric: tabular-nums;
  }

  .set-note {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-ui);
  }

  .set-note .icon {
    width: 1rem;
    height: 1rem;
    margin-top: 0.1rem;
    color: var(--maroon-800);
  }

  /* ── Payments ── */
  .set-mode {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    background: var(--bg-tint);
    color: var(--maroon-800);
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
    line-height: 1.2;
    white-space: nowrap;
  }

  .set-mode::before {
    content: "";
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--maroon-800);
  }

  .set-paystate {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .set-paystate > div {
    display: grid;
    gap: 0.15rem;
  }

  .set-paystate-title {
    color: var(--text);
    font-size: var(--text-base);
    font-weight: var(--weight-strong);
    letter-spacing: -0.01em;
  }

  .set-golive {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
  }

  .set-h3 {
    font-size: var(--text-sm);
    font-weight: var(--weight-strong);
    letter-spacing: 0;
  }

  /* Numbered steps, each a small open circle: none is done yet. */
  .set-steps {
    list-style: none;
    display: grid;
    gap: var(--space-3);
    counter-reset: step;
  }

  .set-steps li {
    position: relative;
    display: grid;
    gap: 0.1rem;
    padding-left: 2.25rem;
    counter-increment: step;
  }

  .set-steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border: 1.5px solid var(--border-control);
    border-radius: 50%;
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
    font-variant-numeric: tabular-nums;
  }

  .set-steps strong {
    color: var(--text);
    font-weight: var(--weight-strong);
  }

  .set-steps span {
    color: var(--text-muted);
  }

  .set-live-btn {
    justify-self: start;
  }

  /* ── Domain ── */
  .set-domain {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-soft);
  }

  .set-domain-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    flex: 1 1 auto;
    min-width: 0;
    min-height: 2.75rem;
    color: var(--text);
    font-size: var(--text-base);
    font-weight: var(--weight-strong);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .set-domain-link > span:first-child {
    overflow-wrap: anywhere;
  }

  .set-domain-link .icon {
    width: 1rem;
    height: 1rem;
    color: var(--text-muted);
  }

  .set-domain-link:hover {
    color: var(--accent);
  }

  .set-facts {
    display: grid;
    margin: 0;
  }

  .set-facts > div {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1) var(--space-4);
    padding: var(--space-3) 0;
  }

  .set-facts > div + div {
    border-top: 1px solid var(--border);
  }

  .set-facts dt {
    color: var(--text-muted);
    font-weight: var(--weight-ui);
  }

  .set-facts dd {
    margin: 0;
    color: var(--text);
    font-weight: var(--weight-strong);
  }

  .set-facts a {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
    color: inherit;
    text-decoration-color: var(--border-strong);
  }

  .set-facts a:hover {
    color: var(--accent);
  }

  /* ── Notifications ── */
  .set-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-2) var(--space-3) var(--card-pad);
  }

  .set-toggle-text {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
    cursor: pointer;
  }

  .set-toggle-title {
    color: var(--text);
    font-weight: var(--weight-strong);
  }

  .set-toggle-desc {
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-ui);
  }

  .set-toggle .switch {
    margin-right: var(--space-2);
  }

  /* ── Reset ── */
  .set-reset {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .set-reset > div {
    display: grid;
    gap: var(--space-1);
  }

  .set-reset-count {
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-ui);
  }

  .set-reset-btn {
    justify-self: start;
  }

  @media (max-width: 30rem) {
    .set-live-btn,
    .set-reset-btn {
      justify-self: stretch;
    }
  }
</style>
