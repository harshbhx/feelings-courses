---
// Activity: the audit log (GET /api/admin/audit), newest first, 50 at a time with "Show older".
// Every admin change is recorded with what it touched (never the tax number's value).
import Admin from "../../layouts/Admin.astro";
---

<Admin title="Activity" active="activity" icons={["list-checks", "arrow-right", "caret-down"]}>
  <header class="page-head">
    <div>
      <a class="back-link mobile-only" href="/admin/settings">Settings</a>
      <h1 class="page-title">Activity</h1>
      <p class="page-sub">Everything changed in the admin, newest first: courses, access, refunds, settings and sign-ins.</p>
    </div>
  </header>

  <div class="toolbar">
    <label class="tb-select">
      <span class="visually-hidden">Show</span>
      <select class="select" data-entity></select>
    </label>
  </div>

  <section class="card" aria-labelledby="act-title">
    <h2 class="visually-hidden" id="act-title">Activity log</h2>
    <div data-region></div>
    <div class="pager" data-more-wrap hidden>
      <span data-count aria-live="polite"></span>
      <button class="btn btn-secondary btn-sm" type="button" data-more>Show older</button>
    </div>
  </section>
</Admin>

<script>
  import "../../components/admin/client/activity";
</script>

<style is:global>
  .tb-select {
    flex: 0 1 16rem;
    min-width: 10rem;
  }

  .act-list {
    list-style: none;
  }

  .act {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.15rem var(--space-4);
    padding: var(--space-3) var(--card-pad);
  }

  .act + .act {
    border-top: 1px solid var(--border);
  }

  .act-what {
    color: var(--text);
    font-weight: var(--weight-strong);
  }

  .act-when {
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-ui);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .act-detail {
    grid-column: 1 / -1;
    color: var(--text-muted);
    font-size: var(--text-xs);
    overflow-wrap: anywhere;
  }

  .act-detail a {
    color: var(--text);
    font-weight: var(--weight-strong);
  }

  .act-day {
    padding: var(--space-2) var(--card-pad);
    background: var(--bg-soft);
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
    border-top: 1px solid var(--border);
  }

  .act-list > .act-day:first-child {
    border-top: 0;
  }

  @media (min-width: 64rem) {
    .mobile-only {
      display: none;
    }
  }
</style>
