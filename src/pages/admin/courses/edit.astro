---
// Course editor (DEMO): /admin/courses/edit for a new course, ?id=… to edit one. Title, price,
// level, language, a cover (a glimpse from course.ts or an uploaded photo), outcomes, modules and
// lessons, Publish and Preview. Saved to the browser's store (src/lib/demo-store.ts); published
// courses show on /catalog and at /course?id=….
import Admin from "../../../layouts/Admin.astro";
import Icon from "../../../components/Icon.astro";
import CoverData from "../../../components/admin/CoverData.astro";
import { getGlimpseCovers } from "../../../components/admin/glimpse-covers";
import { LANGUAGES, LEVELS } from "../../../lib/demo-store";

const glimpses = await getGlimpseCovers(320);
---

<Admin
  title="Edit course"
  active="courses"
  noTabbar
  icons={["arrow-up", "arrow-down", "trash", "plus", "youtube", "clock", "warning-circle", "eye", "arrow-right"]}
>
  <div class="ed-wrap" data-editor>
    <header class="page-head ed-head">
      <div>
        <a class="back-link" href="/admin/courses">
          <Icon name="arrow-left" />
          Courses
        </a>
        <h1 class="page-title" data-ed-heading>New course</h1>
        <p class="ed-state" data-ed-state>New · not saved yet</p>
      </div>
      <div class="page-actions ed-head-actions">
        <a class="btn btn-ghost" href="#" data-preview>
          <Icon name="eye" />
          Preview
        </a>
        <button class="btn btn-primary" type="submit" form="course-form" data-save-label>Save draft</button>
      </div>
    </header>

    <p class="notice" data-main-note hidden>
      <Icon name="info" />
      <span>
        This is your main course. Its sales page is built from the site’s course file, so in the demo your edits show in the
        catalog and the preview, not on the main page.
      </span>
    </p>

    <div class="error-summary" data-summary tabindex="-1" hidden>
      <h2><Icon name="warning-circle" /><span data-summary-title>Fix these first</span></h2>
      <ul data-summary-list></ul>
    </div>

    <form id="course-form" class="ed" novalidate>
      <div class="ed-main">
        <section class="card" aria-labelledby="sec-basics">
          <div class="card-head">
            <h2 class="card-title" id="sec-basics">Basics</h2>
          </div>
          <div class="card-pad form-grid cols-2">
            <div class="field span-all">
              <label class="field-label" for="f-title">Course title</label>
              <input class="input" id="f-title" name="title" type="text" maxlength="80" autocomplete="off" placeholder="e.g. Bridal makeup at home" aria-describedby="f-title-err" />
              <p class="field-error" id="f-title-err"></p>
            </div>
            <div class="field span-all">
              <label class="field-label" for="f-subtitle">One-line description</label>
              <textarea class="textarea" id="f-subtitle" name="subtitle" rows="2" maxlength="160" placeholder="What will students be able to do after this course?" aria-describedby="f-subtitle-hint f-subtitle-err"></textarea>
              <p class="field-hint" id="f-subtitle-hint"><span data-count-subtitle>0</span>/160 · shown under the title</p>
              <p class="field-error" id="f-subtitle-err"></p>
            </div>
            <div class="field">
              <label class="field-label" for="f-price">Price</label>
              <div class="input-affix">
                <span class="affix" aria-hidden="true">₹</span>
                <input class="input num" id="f-price" name="price" type="text" inputmode="numeric" autocomplete="off" placeholder="2999" aria-describedby="f-price-hint f-price-err" />
              </div>
              <p class="field-hint" id="f-price-hint">In rupees, one-time payment</p>
              <p class="field-error" id="f-price-err"></p>
            </div>
            <div class="field">
              <label class="field-label" for="f-level">Level</label>
              <select class="select" id="f-level" name="level">
                {LEVELS.map((l) => <option value={l}>{l}</option>)}
              </select>
            </div>
            <div class="field span-all">
              <label class="field-label" for="f-language">Language</label>
              <select class="select" id="f-language" name="language">
                {LANGUAGES.map((l) => <option value={l}>{l}</option>)}
              </select>
            </div>
          </div>
        </section>

        <section class="card" aria-labelledby="sec-cover">
          <div class="card-head">
            <div>
              <h2 class="card-title" id="sec-cover">Cover</h2>
              <p class="card-sub">Pick a glimpse from your videos, or upload a photo.</p>
            </div>
          </div>
          <div class="card-pad">
            <div class="cover-grid" role="radiogroup" aria-labelledby="sec-cover" data-cover-grid>
              {
                glimpses.map((g) => (
                  <label class="cover-opt">
                    <input type="radio" name="cover" value={`glimpse:${g.id}`} aria-label={g.label} />
                    <img src={g.src} alt="" width="160" height="200" loading="lazy" decoding="async" />
                    <span class="cover-tick" aria-hidden="true">
                      <Icon name="check" />
                    </span>
                  </label>
                ))
              }
              <label class="cover-opt cover-own" data-own hidden>
                <input type="radio" name="cover" value="upload" aria-label="Your uploaded photo" />
                <img data-own-img alt="" width="160" height="200" />
                <span class="cover-tick" aria-hidden="true">
                  <Icon name="check" />
                </span>
                <span class="cover-own-tag">Your photo</span>
              </label>
              <div class="cover-opt cover-add">
                <input
                  type="file"
                  id="f-cover"
                  accept="image/jpeg,image/png,image/webp"
                  aria-label="Upload a cover photo"
                  aria-describedby="f-cover-hint f-cover-err"
                />
                <span class="cover-add-inner" aria-hidden="true">
                  <Icon name="upload-simple" />
                  <span data-add-label>Upload a photo</span>
                </span>
              </div>
            </div>
            <p class="field-hint cover-hint" id="f-cover-hint">JPG, PNG or WebP, up to 8 MB. It’s cropped to 4:5 and made smaller to fit.</p>
            <p class="field-error" id="f-cover-err" role="alert"></p>
            <button class="link-btn cover-remove" type="button" data-remove-own hidden>
              <Icon name="trash" />
              Remove your photo
            </button>
          </div>
        </section>

        <section class="card" aria-labelledby="sec-outcomes">
          <div class="card-head">
            <div>
              <h2 class="card-title" id="sec-outcomes">What students will learn</h2>
              <p class="card-sub">Short points. They show as a checklist on the course page.</p>
            </div>
          </div>
          <div class="card-pad ed-list-pad">
            <ol class="outcomes" data-outcomes></ol>
            <p class="field-error" id="f-outcomes-err" tabindex="-1"></p>
            <button class="btn btn-secondary ed-add" type="button" data-add-outcome>
              <Icon name="plus" />
              Add a point
            </button>
          </div>
        </section>

        <section class="card" aria-labelledby="sec-modules">
          <div class="card-head">
            <div>
              <h2 class="card-title" id="sec-modules">Modules and lessons</h2>
              <p class="card-sub" data-curriculum-sum>&nbsp;</p>
            </div>
          </div>
          <div class="card-pad ed-list-pad">
            <div class="mods" data-modules></div>
            <p class="field-error" id="f-modules-err" tabindex="-1"></p>
            <button class="btn btn-secondary ed-add" type="button" data-add-module>
              <Icon name="plus" />
              Add a module
            </button>
          </div>
        </section>
      </div>

      <aside class="ed-side" aria-label="Publish">
        <section class="card card-pad ed-publish" aria-labelledby="pub-title">
          <div class="pub-row">
            <div>
              <h2 class="card-title" id="pub-title">Publish</h2>
              <p class="card-sub" id="pub-help" data-pub-help>Off: a draft only you can see.</p>
            </div>
            <label class="switch">
              <input type="checkbox" role="switch" id="f-publish" aria-labelledby="pub-title" aria-describedby="pub-help" />
              <span class="switch-track"></span>
            </label>
          </div>
          <div class="pub-actions">
            <button class="btn btn-primary" type="submit" data-save-label>Save draft</button>
            <a class="btn btn-secondary" href="#" data-preview>
              <Icon name="eye" />
              Preview
            </a>
          </div>
          <p class="pub-live" data-live hidden>
            <span class="pill pill-live">Live</span>
            <a class="link-btn" href="/catalog">
              See it in the catalog
              <Icon name="arrow-right" />
            </a>
          </p>
        </section>

        <section class="card ed-card-preview" aria-labelledby="cardprev-title">
          <p class="cardprev-label" id="cardprev-title">How it looks in the catalog</p>
          <div class="cardprev" aria-hidden="true">
            <img data-prev-img alt="" width="320" height="400" />
            <div class="cardprev-body">
              <p class="cardprev-title" data-prev-title>Untitled course</p>
              <p class="cardprev-meta" data-prev-meta>&nbsp;</p>
              <p class="cardprev-price" data-prev-price>&nbsp;</p>
            </div>
          </div>
        </section>

        <button class="btn btn-danger ed-delete" type="button" data-delete hidden>
          <Icon name="trash" />
          Delete this course
        </button>
      </aside>
    </form>

    <div class="action-bar ed-bar">
      <a class="btn btn-secondary" href="#" data-preview>
        <Icon name="eye" />
        Preview
      </a>
      <button class="btn btn-primary" type="submit" form="course-form" data-save-label>Save draft</button>
    </div>
  </div>

  <div class="ed-missing card card-pad" data-missing hidden>
    <h1 class="page-title">We couldn’t find that course</h1>
    <p class="page-sub">It may have been deleted, or the demo data was reset.</p>
    <a class="btn btn-secondary" href="/admin/courses">
      <Icon name="arrow-left" />
      Back to courses
    </a>
  </div>
  <p class="visually-hidden" aria-live="polite" data-announce></p>
  <CoverData />
</Admin>

<script>
  import "../../../components/admin/client/editor";
</script>

<style is:global>
  .ed-head {
    align-items: flex-end;
  }

  .ed-head .page-title {
    overflow-wrap: anywhere;
  }

  .ed-state {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-muted);
    font-weight: var(--weight-ui);
  }

  .ed-head-actions {
    display: none;
  }

  .error-summary {
    margin-bottom: var(--space-4);
  }

  .ed {
    display: grid;
    gap: var(--space-4);
  }

  .ed-main,
  .ed-side {
    display: grid;
    align-content: start;
    gap: var(--space-4);
    min-width: 0;
  }

  @media (min-width: 64rem) {
    .ed-head-actions {
      display: flex;
    }

    .ed-bar {
      display: none;
    }

    .ed {
      grid-template-columns: minmax(0, 1fr) 20rem;
      gap: var(--space-5);
      align-items: start;
    }

    .ed-main {
      gap: var(--space-5);
    }

    .ed-side {
      position: sticky;
      top: calc(4rem + var(--space-5));
    }
  }

  /* ── Cover picker ── */
  .cover-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }

  @media (min-width: 40rem) {
    .cover-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 80rem) {
    .cover-grid {
      grid-template-columns: repeat(7, minmax(0, 1fr));
    }
  }

  .cover-opt {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-md);
    background: var(--bg-tint);
    overflow: hidden;
    cursor: pointer;
    outline: 2px solid transparent;
    outline-offset: 2px;
    transition: outline-color var(--dur-fast) var(--ease-out);
  }

  .cover-opt[hidden] {
    display: none;
  }

  .cover-opt input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
    z-index: 2;
  }

  .cover-opt img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cover-opt:hover {
    outline-color: var(--border-control);
  }

  .cover-opt:has(input:checked) {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  .cover-opt:has(input:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 4px;
  }

  .cover-tick {
    position: absolute;
    top: 0.4rem;
    right: 0.4rem;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-accent);
    opacity: 0;
    transform: scale(0.6);
    transition: opacity var(--dur-fast) var(--ease-out), transform var(--dur-base) var(--ease-soft);
  }

  .cover-tick .icon {
    width: 0.9rem;
    height: 0.9rem;
  }

  .cover-opt:has(input:checked) .cover-tick {
    opacity: 1;
    transform: none;
  }

  .cover-own-tag {
    position: absolute;
    inset: auto 0.4rem 0.4rem;
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-sm);
    background: var(--bg-glass);
    color: var(--text);
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
    text-align: center;
  }

  .cover-add {
    display: grid;
    place-items: center;
    border: 1.5px dashed var(--border-control);
    background: var(--bg-soft);
    color: var(--text-body);
  }

  .cover-add-inner {
    display: grid;
    justify-items: center;
    gap: var(--space-1);
    padding: var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
    text-align: center;
    line-height: 1.3;
  }

  .cover-add-inner .icon {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--maroon-800);
  }

  .cover-add:hover {
    border-color: var(--text-muted);
    background: var(--bg-tint);
  }

  .cover-hint {
    margin-top: var(--space-3);
  }

  .cover-hint + .field-error {
    margin-top: var(--space-2);
  }

  .cover-remove {
    margin-top: var(--space-1);
    color: var(--text-body);
  }

  @media (prefers-reduced-motion: reduce) {
    .cover-tick {
      transform: none;
    }
  }

  /* ── Lists: outcomes, modules, lessons ── */
  .ed-list-pad {
    display: grid;
    gap: var(--space-3);
  }

  .ed-add {
    justify-self: start;
  }

  .outcomes {
    list-style: none;
    display: grid;
    gap: var(--space-2);
  }

  .oc {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-2);
  }

  .oc > .field-error {
    grid-column: 2 / -1;
  }

  .oc-num,
  .les-num {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--bg-tint);
    color: var(--maroon-800);
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
  }

  .tools {
    display: flex;
    align-items: center;
  }

  .tools .icon-btn {
    width: 2.75rem;
    height: 2.75rem;
  }

  .tools .icon-btn.danger:hover {
    color: var(--accent);
  }

  @media (max-width: 29.99rem) {
    .oc {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .oc-num {
      display: none;
    }

    .oc > .field-error {
      grid-column: 1 / -1;
    }

    .oc .tools .icon-btn {
      width: 2.5rem;
    }
  }

  .mods {
    display: grid;
    gap: var(--space-4);
  }

  .mod {
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--bg-soft);
  }

  .mod-head {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-3) var(--space-3) var(--space-4);
  }

  .mod-top,
  .les-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: 2.75rem;
  }

  .mod-label {
    color: var(--maroon-800);
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .mod-head .field {
    padding-right: var(--space-1);
  }

  .lessons {
    list-style: none;
    display: grid;
    gap: var(--space-2);
    padding: 0 var(--space-3) var(--space-3);
  }

  .les {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-2) var(--space-3) var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg);
  }

  .les-label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text);
    font-weight: var(--weight-strong);
  }

  .les-fields {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: var(--space-2) var(--space-3);
    padding-right: var(--space-1);
  }

  .les-fields .f-title {
    grid-column: 1 / -1;
  }

  .les-fields .field-label {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  @media (min-width: 48rem) {
    .les-fields {
      grid-template-columns: minmax(0, 1.4fr) 6.5rem minmax(0, 1fr);
    }

    .les-fields .f-title {
      grid-column: auto;
    }
  }

  .add-lesson {
    justify-self: start;
    margin-left: var(--space-1);
  }

  /* ── Side: publish and card preview ── */
  .ed-publish {
    display: grid;
    gap: var(--space-4);
  }

  .pub-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .pub-row .card-sub {
    margin-top: 0.15rem;
    font-size: var(--text-xs);
  }

  .pub-actions {
    display: none;
  }

  @media (min-width: 64rem) {
    .pub-actions {
      display: grid;
      gap: var(--space-2);
    }
  }

  .pub-live {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  .pub-live[hidden] {
    display: none;
  }

  .ed-card-preview {
    padding: var(--space-4);
  }

  .cardprev-label {
    margin-bottom: var(--space-3);
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
  }

  .cardprev {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--space-3);
    align-items: start;
  }

  .cardprev img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-sm);
    background: var(--bg-tint);
  }

  .cardprev-body {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }

  .cardprev-title {
    color: var(--text);
    font-weight: var(--weight-strong);
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .cardprev-meta {
    color: var(--text-muted);
    font-size: var(--text-xs);
  }

  .cardprev-price {
    color: var(--text);
    font-weight: var(--weight-display);
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 64rem) {
    .cardprev {
      grid-template-columns: 1fr;
    }

    .cardprev img {
      aspect-ratio: 4 / 3;
      object-position: 50% 25%;
    }
  }

  .ed-delete {
    justify-self: start;
  }

  .ed-missing {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }
</style>
