---
// Payments: every order (GET /api/admin/orders) with filters for status, course and dates, the CSV
// export, an order drawer (?open=<id>) with refunds inside the 24-hour window and "Re-check with
// Razorpay" (W2), and the Razorpay events list with Replay for an event that failed. No tax number and no
// tax lines anywhere (owner decision).
import Admin from "../../layouts/Admin.astro";
import Icon from "../../components/Icon.astro";
---

<Admin
  title="Payments"
  active="payments"
  icons={["download-simple", "receipt", "arrow-left", "arrow-right", "currency-inr", "users-three", "arrow-counter-clockwise", "x-circle", "credit-card", "clock"]}
>
  <header class="page-head">
    <div>
      <h1 class="page-title">Payments</h1>
      <p class="page-sub">Every order and refund. Refunds are possible for 24 hours after a payment.</p>
    </div>
    <div class="page-actions">
      <a class="btn btn-secondary" href="/api/admin/orders.csv" download data-export>
        <Icon name="download-simple" />
        Export CSV
      </a>
    </div>
  </header>

  <form class="toolbar pay-filters" data-filters>
    <label class="field pay-f">
      <span class="field-label">Status</span>
      <select class="select" name="status" data-status>
        <option value="">Any status</option>
        <option value="paid">Paid</option>
        <option value="created">Not paid</option>
        <option value="failed">Failed</option>
        <option value="partially_refunded">Part refunded</option>
        <option value="refunded">Refunded</option>
      </select>
    </label>
    <label class="field pay-f">
      <span class="field-label">Course</span>
      <select class="select" name="course" data-course>
        <option value="">All courses</option>
      </select>
    </label>
    <label class="field pay-f">
      <span class="field-label">From</span>
      <input class="input" type="date" name="from" data-from />
    </label>
    <label class="field pay-f">
      <span class="field-label">To</span>
      <input class="input" type="date" name="to" data-to />
    </label>
    <button class="btn btn-ghost pay-clear" type="button" data-clear hidden>Clear</button>
  </form>
  <p class="field-error pay-filter-err" role="alert" data-filter-err></p>

  <section class="card" aria-labelledby="orders-title">
    <h2 class="visually-hidden" id="orders-title">Orders</h2>
    <div data-region style="--skel-rows: 5"></div>
    <div class="pager" data-pager hidden>
      <span data-page-label aria-live="polite"></span>
      <div class="pager-btns">
        <button class="btn btn-secondary btn-sm" type="button" data-prev><Icon name="arrow-left" />Previous</button>
        <button class="btn btn-secondary btn-sm" type="button" data-next>Next<Icon name="arrow-right" /></button>
      </div>
    </div>
  </section>

  <section class="card wh-card" aria-labelledby="wh-title">
    <div class="card-head">
      <div>
        <h2 class="card-title" id="wh-title">Razorpay events</h2>
        <p class="card-sub">What Razorpay told the site (payments, refunds). An event that failed can be replayed.</p>
      </div>
      <label class="switch-inline">
        <input type="checkbox" data-pending />
        <span>Only unprocessed</span>
      </label>
    </div>
    <div data-webhooks style="--skel-rows: 3"></div>
  </section>
</Admin>

<script>
  import "../../components/admin/client/payments";
</script>

<style is:global>
  .pay-filters {
    align-items: flex-end;
  }

  .pay-f {
    flex: 1 1 9rem;
    min-width: 8.5rem;
  }

  .pay-filter-err {
    margin: calc(var(--space-2) * -1) 0 var(--space-3);
  }

  .wh-card {
    margin-top: var(--space-5);
  }

  .switch-inline {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    color: var(--text-body);
    font-weight: var(--weight-ui);
    white-space: nowrap;
    cursor: pointer;
  }

  .switch-inline input {
    width: 1.15rem;
    height: 1.15rem;
    accent-color: var(--accent);
  }

  .amount-strong {
    color: var(--text);
    font-weight: var(--weight-strong);
  }

  .refund-window {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-body);
    font-weight: var(--weight-ui);
  }

  .refund-window .icon {
    color: var(--maroon-800);
  }

  .wh-err {
    color: var(--accent);
    font-size: var(--text-xs);
    font-weight: var(--weight-ui);
    overflow-wrap: anywhere;
  }
</style>
