---
// Students (DEMO): every example student, how far they've got, and their payment. The list is
// built in the browser from src/lib/demo-store-students.ts (derived from the dashboard's example
// activity, so the numbers agree). Script: src/components/admin/students/students.ts.
import Admin from "../../layouts/Admin.astro";
import Icon from "../../components/Icon.astro";
import { TXN_ICONS } from "../../components/admin/payments/icons";
import "../../components/admin/payments/txn.css";
import "../../components/admin/students/students.css";

const icons = ["caret-right", "circle", "users-three", "magnifying-glass", "arrow-right", ...TXN_ICONS];
const skeletons = Array.from({ length: 6 });
---

<Admin title="Students" active="students" icons={icons}>
  <header class="page-head">
    <div>
      <h1 class="page-title">Students</h1>
      <p class="page-sub">Everyone who bought a course, how far they’ve got and what they paid.</p>
      <p class="demo-note">
        <Icon name="info" />
        Example students (demo data). Phone numbers are masked.
      </p>
    </div>
    <div class="page-actions">
      <button class="btn btn-secondary" type="button" data-export>
        <Icon name="download-simple" />
        Export CSV
      </button>
    </div>
  </header>

  <section class="stu-stats" aria-label="Students at a glance">
    <article class="card stu-stat">
      <h2 class="stu-stat-label">Students</h2>
      <p class="stu-stat-value num" data-s="total">&nbsp;</p>
      <p class="stu-stat-meta" data-s="total-meta">&nbsp;</p>
    </article>
    <article class="card stu-stat">
      <h2 class="stu-stat-label">Active this week</h2>
      <p class="stu-stat-value num" data-s="active">&nbsp;</p>
      <p class="stu-stat-meta">Watched a lesson in 7 days</p>
    </article>
    <article class="card stu-stat">
      <h2 class="stu-stat-label">Finished</h2>
      <p class="stu-stat-value num" data-s="finished">&nbsp;</p>
      <p class="stu-stat-meta" data-s="finished-meta">&nbsp;</p>
    </article>
    <article class="card stu-stat">
      <h2 class="stu-stat-label">Not started</h2>
      <p class="stu-stat-value num" data-s="none">&nbsp;</p>
      <p class="stu-stat-meta">Haven’t opened a lesson yet</p>
    </article>
  </section>

  <div class="stu-toolbar" role="search" aria-label="Find students">
    <div class="search stu-search">
      <Icon name="magnifying-glass" />
      <label class="visually-hidden" for="stu-q">Search students by name, city or phone</label>
      <input
        id="stu-q"
        class="input"
        type="search"
        placeholder="Search name, city or phone"
        autocomplete="off"
        spellcheck="false"
        enterkeyhint="search"
        maxlength="80"
      />
    </div>
    <div class="stu-filters">
      <div class="stu-filter">
        <label class="visually-hidden" for="stu-course">Course</label>
        <select id="stu-course" class="select">
          <option value="">All courses</option>
        </select>
      </div>
      <div class="stu-filter">
        <label class="visually-hidden" for="stu-progress">Progress</label>
        <select id="stu-progress" class="select">
          <option value="">Any progress</option>
          <option value="none">Not started</option>
          <option value="some">In progress</option>
          <option value="done">Finished</option>
        </select>
      </div>
    </div>
  </div>

  <section class="card stu-card" aria-labelledby="stu-list-title">
    <div class="stu-bar">
      <h2 class="visually-hidden" id="stu-list-title">Student list</h2>
      <p class="stu-total" data-count>Loading students…</p>
      <button class="link-btn stu-clear" type="button" data-clear-top hidden>
        <Icon name="close" />
        Clear filters
      </button>
      <div class="stu-sort">
        <label class="stu-sort-label" for="stu-sort">Sort</label>
        <select id="stu-sort" class="select">
          <option value="new">Newest first</option>
          <option value="old">Oldest first</option>
          <option value="most">Most progress</option>
          <option value="least">Least progress</option>
          <option value="name">Name, A to Z</option>
        </select>
      </div>
    </div>

    <div class="stu-wrap">
      <div class="stu-row stu-head" aria-hidden="true">
        <span class="stu-name">Student</span>
        <span class="stu-phone">Phone</span>
        <span class="stu-course">Course</span>
        <span class="stu-meter">Progress</span>
        <span class="stu-date">Enrolled</span>
      </div>
      <ul class="rows stu-list" data-list aria-busy="true" aria-labelledby="stu-list-title">
        {
          skeletons.map(() => (
            <li class="stu-row stu-skel" aria-hidden="true">
              <span class="avatar avatar-soft stu-av" />
              <span class="stu-name">
                <span class="skel" />
              </span>
              <span class="stu-city">
                <span class="skel skel-short" />
              </span>
              <span class="stu-course">
                <span class="skel" />
              </span>
              <span class="meter stu-meter" />
            </li>
          ))
        }
      </ul>
      <div data-states></div>
    </div>

    <div class="stu-more">
      <button class="btn btn-secondary" type="button" data-more hidden>Show more</button>
    </div>
  </section>

  <p class="visually-hidden" aria-live="polite" data-live></p>

  <noscript>
    <p class="notice">This demo builds the student list in the browser, so it needs JavaScript turned on.</p>
  </noscript>

  <dialog class="drawer stu-drawer" data-student-drawer aria-labelledby="stu-d-name">
    <div class="drawer-head stu-d-head" data-drawer-head></div>
    <div class="drawer-body stu-d-body" data-drawer-body></div>
  </dialog>
</Admin>

<script>
  import "../../components/admin/students/students";
</script>
