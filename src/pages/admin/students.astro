---
// Students: search, filter by course, page through (GET /api/admin/students), export CSV, add a
// student who paid at the studio, and a detail drawer (?open=<id>) with access, payments, devices,
// certificates, a WhatsApp sign-in link, and the DPDP erase. Phones are masked in the list.
import Admin from "../../layouts/Admin.astro";
import Icon from "../../components/Icon.astro";
---

<Admin
  title="Students"
  active="students"
  icons={["magnifying-glass", "download-simple", "plus", "whatsapp", "device-mobile", "certificate", "trash", "sign-out", "link-simple", "users-three", "calendar-check", "receipt", "x-circle", "arrow-right", "arrow-left"]}
>
  <header class="page-head">
    <div>
      <h1 class="page-title">Students</h1>
      <p class="page-sub">Everyone who bought a course or was added by hand. Tap a name for their access, payments and devices.</p>
    </div>
    <div class="page-actions">
      <a class="btn btn-secondary" href="/api/admin/students.csv" download data-export>
        <Icon name="download-simple" />
        Export CSV
      </a>
      <button class="btn btn-primary" type="button" data-add>
        <Icon name="plus" />
        Add student
      </button>
    </div>
  </header>

  <form class="toolbar" role="search" data-filters>
    <label class="search">
      <span class="visually-hidden">Search students</span>
      <Icon name="magnifying-glass" />
      <input class="input" type="search" name="q" placeholder="Name, phone or email" autocomplete="off" maxlength="100" data-q />
    </label>
    <label class="tb-select">
      <span class="visually-hidden">Course</span>
      <select class="select" name="course" data-course>
        <option value="">All courses</option>
      </select>
    </label>
    <button class="btn btn-ghost" type="button" data-clear hidden>Clear</button>
  </form>

  <section class="card" aria-labelledby="list-title">
    <h2 class="visually-hidden" id="list-title">Student list</h2>
    <div data-region></div>
    <div class="pager" data-pager hidden>
      <span data-page-label aria-live="polite"></span>
      <div class="pager-btns">
        <button class="btn btn-secondary btn-sm" type="button" data-prev><Icon name="arrow-left" />Previous</button>
        <button class="btn btn-secondary btn-sm" type="button" data-next>Next<Icon name="arrow-right" /></button>
      </div>
    </div>
  </section>
  <p class="page-note list-note">
    <Icon name="info" />
    Phone numbers are hidden in the list. Open a student to see them; the CSV export has them in full.
  </p>
</Admin>

<script>
  import "../../components/admin/client/students";
</script>

<style is:global>
  .tb-select {
    flex: 0 1 14rem;
    min-width: 10rem;
  }

  .list-note {
    margin-top: var(--space-3);
  }

  .stu-name {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
  }

  .stu-name .dt-row-btn {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .stu-erased {
    color: var(--text-muted);
    font-style: italic;
  }

  .drawer-section {
    display: grid;
    gap: var(--space-3);
  }

  .drawer-section + .drawer-section {
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .enr-head {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }

  .enr-title {
    color: var(--text);
    font-weight: var(--weight-strong);
    overflow-wrap: anywhere;
  }

  .enr-meta {
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-ui);
  }

  .danger-box {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
  }
</style>
