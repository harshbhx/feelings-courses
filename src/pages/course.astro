---
// /course?id=…: the public page of a course published from the admin demo. The course lives in
// this browser's demo store (src/lib/demo-store.ts), so the browser draws the page from it:
// hero, what you'll learn, lessons and a price card, in the landing page's style.
//
// Checkout is NOT mounted here: it charges the main course's price. Every Enroll button is a
// plain link with data-enroll to #price, and with JavaScript it opens a labelled demo note
// instead, with a way to try the full test checkout on the main course (/).
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Header from "../components/landing/Header.astro";
import Footer from "../components/landing/Footer.astro";
import IconSprite from "../components/admin/IconSprite.astro";
import CoverData from "../components/admin/CoverData.astro";
import { course as mainCourse } from "../data/course";
import { site } from "../data/site";
---

<Base title={`Course | ${site.name}`} description={`An online course by ${mainCourse.teacher}, ${site.name}.`}>
  <a class="skip-link" href="#main">Skip to content</a>
  <Header />
  <p class="cp-bar" data-preview-bar hidden>
    <span data-preview-text>Preview of a draft: students can’t see this page yet.</span>
    <a href="/admin/courses" data-back-editor>
      <Icon name="arrow-left" />
      Back to the editor
    </a>
  </p>
  <main id="main" class="cp" data-course-page>
    <div class="container cp-state" data-state="loading">
      <p class="muted">Loading the course…</p>
      <noscript><p>This page needs JavaScript to show the course. <a href="/catalog">See all courses</a>.</p></noscript>
    </div>

    <div class="container cp-state cp-missing" data-state="missing" hidden>
      <h1 data-missing-title>This course isn’t available</h1>
      <p class="lead" data-missing-text>It may not be published yet, or the link is incomplete.</p>
      <a class="btn btn-secondary" href="/catalog">
        See all courses
        <Icon name="arrow-right" />
      </a>
    </div>

    <article data-state="course" hidden>
      <section class="cp-hero" aria-labelledby="cp-title">
        <div class="container cp-hero-grid">
          <div class="cp-hero-text">
            <p class="eyebrow">Online course by {mainCourse.teacher}</p>
            <h1 id="cp-title" class="cp-title"><span data-c="title"></span><span class="bindi" aria-hidden="true"></span></h1>
            <p class="lead" data-c="subtitle"></p>
            <ul class="cp-stats" aria-label="The course at a glance">
              <li><span class="cp-stat-value" data-c="lessons"></span><span class="cp-stat-unit" data-c="lessons-unit">lessons</span></li>
              <li><span class="cp-stat-value" data-c="minutes"></span><span class="cp-stat-unit">minutes</span></li>
              <li><span class="cp-stat-value cp-stat-text" data-c="level"></span><span class="cp-stat-unit">level</span></li>
            </ul>
            <ul class="cp-extras">
              <li><Icon name="translate" /><span data-c="language"></span></li>
              <li><Icon name="device-mobile" />Watch on phone or laptop</li>
            </ul>
            <div class="cp-actions">
              <a class="btn btn-primary" href="#price" data-enroll>
                <span data-c="enroll-label">Enroll</span>
                <Icon name="arrow-right" />
              </a>
              <a class="link-arrow" href="#lessons" data-c="see-lessons">See all lessons</a>
            </div>
          </div>
          <div class="cp-cover">
            <img data-c="cover" alt="" width="720" height="900" />
          </div>
        </div>
      </section>

      <section class="section band-soft" id="learn" aria-labelledby="learn-title">
        <div class="container">
          <div class="section-head">
            <h2 id="learn-title">What you’ll learn<span class="bindi" aria-hidden="true"></span></h2>
          </div>
          <ul class="cp-outcomes" data-c="outcomes"></ul>
        </div>
      </section>

      <section class="section" id="lessons" aria-labelledby="lessons-title">
        <div class="container">
          <div class="section-head">
            <h2 id="lessons-title">Lessons<span class="bindi" aria-hidden="true"></span></h2>
            <p class="lead" data-c="lessons-sum"></p>
          </div>
          <div class="cp-modules" data-c="modules"></div>
        </div>
      </section>

      <section class="section band-soft" id="price" aria-labelledby="price-title">
        <div class="container cp-price-grid">
          <div class="cp-price-head">
            <h2 id="price-title">Join the course<span class="bindi" aria-hidden="true"></span></h2>
            <p class="lead" data-c="price-lead"></p>
          </div>
          <div class="cp-card">
            <div class="cp-card-top">
              <p class="cp-card-name" data-c="card-title"></p>
              <p class="cp-amount" data-c="price"></p>
              <p class="cp-card-note">One-time payment</p>
            </div>
            <div class="cp-card-body">
              <ul class="cp-included" data-c="included" aria-label="What’s included"></ul>
              <a class="btn btn-primary cp-card-enroll" href="#price" data-enroll>
                <span data-c="enroll-label">Enroll</span>
                <Icon name="arrow-right" />
              </a>
              <a class="btn btn-secondary" href="#" data-c="whatsapp" target="_blank" rel="noopener">
                <Icon name="whatsapp" />
                Ask {mainCourse.teacher.split(" ")[0]} a question
              </a>
            </div>
          </div>
        </div>
      </section>
    </article>
  </main>

  <dialog class="cp-dlg" data-enroll-dialog aria-labelledby="enroll-dlg-title">
    <form method="dialog" class="cp-dlg-body">
      <span class="cp-dlg-badge">Demo</span>
      <h2 id="enroll-dlg-title" data-dlg-title>Payments for this course come next</h2>
      <p data-dlg-text>Demo: in the real version, students pay for this course here and get its lessons.</p>
      <p class="muted small">You can try the full test checkout on the main course. No money is charged.</p>
      <div class="cp-dlg-actions">
        <a class="btn btn-primary" href="/#pricing">
          Try the full checkout
          <Icon name="arrow-right" />
        </a>
        <button class="btn btn-secondary" value="close">Close</button>
      </div>
    </form>
  </dialog>

  <Footer />
  <IconSprite names={["check-circle", "play-circle", "clock", "lock-simple"]} />
  <CoverData />
</Base>

<script>
  import "../components/admin/client/course-page";
</script>

<style is:global>
  .cp-bar {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-2) var(--gutter);
    background: var(--bg-tint);
    border-bottom: 1px solid var(--border-strong);
    color: var(--text);
    font-size: var(--text-sm);
    font-weight: var(--weight-ui);
    text-align: center;
  }

  .cp-bar[hidden] {
    display: none;
  }

  .cp-bar a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.75rem;
    color: var(--accent);
    font-weight: var(--weight-strong);
  }

  .cp-bar .icon {
    width: 1rem;
    height: 1rem;
  }

  .cp-state {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    padding-block: var(--section-y);
  }

  .cp-state[hidden],
  .cp [hidden] {
    display: none;
  }

  /* ── Hero ── */
  .cp-hero {
    padding-block: var(--space-5) var(--section-y-tight);
  }

  .cp-hero-grid {
    display: grid;
    gap: var(--space-6);
  }

  .cp-hero-text {
    display: grid;
    align-content: start;
    gap: var(--space-4);
  }

  .cp-title {
    font-size: clamp(2.5rem, 1.7rem + 3.4vw, 4rem);
    overflow-wrap: anywhere;
  }

  .cp-stats {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin-top: var(--space-2);
  }

  .cp-stats li {
    display: grid;
    gap: 0.1rem;
  }

  .cp-stat-value {
    color: var(--text);
    font-size: clamp(1.75rem, 1.45rem + 1.2vw, 2.25rem);
    font-weight: var(--weight-display);
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .cp-stat-text {
    font-size: var(--text-lg);
    line-height: 1.6;
    letter-spacing: -0.01em;
  }

  .cp-stat-unit {
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cp-extras {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    color: var(--text-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-ui);
  }

  .cp-extras li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .cp-extras .icon {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--maroon-800);
  }

  .cp-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-5);
    margin-top: var(--space-2);
  }

  @media (max-width: 30rem) {
    .cp-actions .btn {
      flex: 1 1 100%;
    }
  }

  .cp-cover {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--bg-tint);
    box-shadow: var(--shadow-md);
  }

  .cp-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 48rem) {
    .cp-hero {
      padding-top: var(--space-7);
    }

    .cp-hero-grid {
      grid-template-columns: minmax(0, 1fr) clamp(16rem, 32vw, 24rem);
      align-items: center;
      column-gap: clamp(var(--space-6), 5vw, var(--space-9));
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .cp-hero-text > *,
    .cp-cover {
      animation: enter 600ms var(--ease-soft) both;
    }

    .cp-hero-text > :nth-child(2) {
      animation-delay: 60ms;
    }

    .cp-hero-text > :nth-child(3) {
      animation-delay: 120ms;
    }

    .cp-hero-text > :nth-child(n + 4) {
      animation-delay: 180ms;
    }

    .cp-cover {
      animation-delay: 120ms;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cp-hero-text > *,
    .cp-cover {
      animation: fade-in 200ms ease-out both;
    }
  }

  /* ── Outcomes ── */
  .cp-outcomes {
    list-style: none;
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 48rem) {
    .cp-outcomes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4) var(--space-6);
    }
  }

  .cp-outcomes li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg);
    color: var(--text);
    font-weight: var(--weight-ui);
  }

  .cp-outcomes .icon {
    flex: none;
    margin-top: 0.15rem;
    color: var(--accent);
  }

  /* ── Lessons ── */
  .cp-modules {
    display: grid;
    gap: var(--space-5);
    max-width: 48rem;
  }

  .cp-module {
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--bg);
  }

  .cp-module-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-4);
    padding: var(--space-4) var(--space-5);
    background: var(--bg-soft);
    border-bottom: 1px solid var(--border);
  }

  .cp-module-head h3 {
    font-size: var(--text-lg);
  }

  .cp-module-head h3 span {
    display: block;
    margin-bottom: 0.15rem;
    color: var(--maroon-800);
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cp-module-head p {
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-ui);
  }

  .cp-lessons {
    list-style: none;
  }

  .cp-lessons li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-5);
  }

  .cp-lessons li + li {
    border-top: 1px solid var(--border);
  }

  .cp-lessons .icon {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--text-muted);
  }

  .cp-lesson-title {
    color: var(--text);
    font-weight: var(--weight-ui);
  }

  .cp-lesson-min {
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* ── Price card (the landing page's ticket) ── */
  .cp-price-grid {
    display: grid;
    gap: var(--space-6);
  }

  .cp-price-head {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    max-width: 30rem;
  }

  .cp-card {
    width: 100%;
    max-width: 30rem;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--bg);
    box-shadow: var(--shadow-md);
  }

  .cp-card-top {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-6) var(--space-5) var(--space-5);
    background: var(--bg-deep);
    color: var(--text-on-deep-muted);
  }

  .cp-card-name {
    color: var(--text-on-deep);
    font-weight: var(--weight-strong);
  }

  .cp-amount {
    color: var(--text-on-deep);
    font-size: clamp(3rem, 2.4rem + 2.6vw, 4rem);
    font-weight: var(--weight-display);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .cp-card-note {
    font-size: var(--text-sm);
  }

  .cp-card-body {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
  }

  .cp-included {
    list-style: none;
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .cp-included li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    color: var(--text);
  }

  .cp-included .icon {
    flex: none;
    margin-top: 0.15rem;
    color: var(--accent);
  }

  .cp-card-enroll {
    width: 100%;
  }

  @media (min-width: 56rem) {
    .cp-price-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 30rem);
      column-gap: var(--space-8);
      align-items: center;
    }

    .cp-card {
      justify-self: end;
    }

    .cp-card-top {
      padding: var(--space-7) var(--space-6) var(--space-6);
    }

    .cp-card-body {
      padding: var(--space-6);
    }
  }

  /* ── Enroll note (demo) ── */
  .cp-dlg {
    width: min(100% - 2rem, 27rem);
    padding: 0;
    border: 0;
    border-radius: var(--radius-lg);
    background: var(--bg);
    color: var(--text-body);
    box-shadow: var(--shadow-md);
  }

  .cp-dlg::backdrop {
    background: var(--scrim-soft);
  }

  .cp-dlg-body {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-5) var(--space-5);
  }

  .cp-dlg-body h2 {
    font-size: var(--text-xl);
    line-height: 1.2;
  }

  .cp-dlg-badge {
    justify-self: start;
    padding: 0.15rem 0.6rem;
    border-radius: var(--radius-pill);
    background: var(--bg-tint);
    color: var(--maroon-800);
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
  }

  .cp-dlg-actions {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  @media (prefers-reduced-motion: no-preference) {
    .cp-dlg[open] {
      animation: cp-dlg-in 280ms var(--ease-soft);
    }

    .cp-dlg[open]::backdrop {
      animation: fade-in 220ms var(--ease-out);
    }

    @keyframes cp-dlg-in {
      from {
        opacity: 0;
        transform: translateY(10px) scale(0.98);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cp-dlg[open] {
      animation: fade-in 140ms ease-out;
    }
  }
</style>
