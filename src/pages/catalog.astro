---
// /catalog: all published courses. The main course (src/data/course.ts) comes first and links to
// the landing page (/). Courses published from the admin demo are stored in this browser
// (src/lib/demo-store.ts), so the list is drawn by the browser; the main course is in the HTML too,
// for the first paint and without JavaScript.
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Header from "../components/landing/Header.astro";
import Footer from "../components/landing/Footer.astro";
import IconSprite from "../components/admin/IconSprite.astro";
import CoverData from "../components/admin/CoverData.astro";
import { getGlimpseCovers } from "../components/admin/glimpse-covers";
import { course, lessonCount, totalMinutes } from "../data/course";
import { site } from "../data/site";

const covers = await getGlimpseCovers();
const mainCover = covers.find((c) => c.id === course.glimpses[3]?.id) ?? covers[0];
const hours = Math.floor(totalMinutes / 60);
const mins = totalMinutes % 60;
const NB = "\xa0";
const mainDuration = hours ? `${hours}${NB}h${mins ? `${NB}${mins}${NB}min` : ""}` : `${mins}${NB}min`;
---

<Base title={`All courses | ${site.name}`} description={`Online makeup courses by ${course.teacher}, ${site.name}, ${site.address.city}.`}>
  <a class="skip-link" href="#main">Skip to content</a>
  <Header current="courses" />
  <main id="main">
    <section class="cat-hero">
      <div class="container">
        <p class="eyebrow">Online courses by {course.teacher}</p>
        <h1>All courses<span class="bindi" aria-hidden="true"></span></h1>
        <p class="lead">Short video lessons from {site.name}, {site.address.city}. Watch at home on your phone or laptop.</p>
      </div>
    </section>

    <section class="cat-list" aria-label="Courses">
      <div class="container">
        <ul class="cat-grid" data-catalog>
          <li>
            <a class="cat-card" href="/">
              <span class="cat-media">
                <img src={mainCover.src} alt="" width="480" height="600" />
              </span>
              <span class="cat-body">
                <span class="cat-meta">{course.level} · {lessonCount} lessons · {mainDuration}</span>
                <span class="cat-title">{course.title}</span>
                <span class="cat-sub">{course.subtitle}</span>
                <span class="cat-foot">
                  <span class="cat-price">{course.price.display}</span>
                  <span class="cat-go">View course <Icon name="arrow-right" /></span>
                </span>
              </span>
            </a>
          </li>
        </ul>
        <p class="cat-note">
          <Icon name="info" />
          <span data-catalog-note>Demo: courses published from the course admin show here, on the device they were made on.</span>
        </p>
      </div>
    </section>
  </main>
  <Footer />
  <IconSprite names={["arrow-right", "book-open-text"]} />
  <CoverData />
</Base>

<script>
  import "../components/admin/client/catalog";
</script>

<style is:global>
  .cat-hero {
    padding-block: var(--space-6) var(--space-5);
  }

  .cat-hero .container {
    display: grid;
    gap: var(--space-3);
  }

  .cat-hero h1 {
    font-size: clamp(2.5rem, 1.9rem + 2.6vw, 4rem);
  }

  .cat-list {
    padding-bottom: var(--section-y);
  }

  .cat-grid {
    list-style: none;
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 40rem) {
    .cat-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .cat-hero {
      padding-block: var(--space-8) var(--space-7);
    }

    .cat-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }

  .cat-card {
    display: grid;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg);
    color: inherit;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);
  }

  .cat-card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
  }

  .cat-card:focus-visible {
    outline-offset: 4px;
    border-radius: var(--radius-lg);
  }

  .cat-media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--bg-tint);
  }

  @media (min-width: 40rem) {
    .cat-media {
      aspect-ratio: 4 / 5;
    }
  }

  .cat-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 22%;
  }

  @media (prefers-reduced-motion: no-preference) and (hover: hover) {
    .cat-media img {
      transition: transform 600ms var(--ease-soft);
    }

    .cat-card:hover .cat-media img {
      transform: scale(1.03);
    }
  }

  .cat-body {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-5);
  }

  .cat-meta {
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-ui);
  }

  .cat-title {
    color: var(--text);
    font-size: var(--text-xl);
    font-weight: var(--weight-strong);
    letter-spacing: -0.015em;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .cat-sub {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: var(--text-body);
    font-size: var(--text-sm);
  }

  .cat-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
  }

  .cat-price {
    color: var(--text);
    font-size: var(--text-lg);
    font-weight: var(--weight-display);
    letter-spacing: -0.02em;
  }

  .cat-go {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    color: var(--accent);
    font-weight: var(--weight-strong);
  }

  .cat-go .icon {
    width: 1.1em;
    height: 1.1em;
  }

  @media (prefers-reduced-motion: no-preference) and (hover: hover) {
    .cat-go .icon {
      transition: transform var(--dur-fast) var(--ease-out);
    }

    .cat-card:hover .cat-go .icon {
      transform: translateX(3px);
    }
  }

  .cat-new {
    display: inline-block;
    justify-self: start;
    padding: 0.1rem 0.55rem;
    border-radius: var(--radius-pill);
    background: var(--bg-tint);
    color: var(--maroon-800);
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
  }

  .cat-note {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    margin-top: var(--space-6);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .cat-note .icon {
    width: 1.1rem;
    height: 1.1rem;
    margin-top: 0.2rem;
    flex: none;
  }

  .cat-empty {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
    padding: var(--space-6);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-lg);
  }
</style>
