---
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/motion.css";
import { site } from "../data/site";
import { course } from "../data/course";
import { buildEnv } from "../lib/build-env";
import { isPreviewBuild, jsonLdText } from "../lib/seo";

interface Props {
  title: string;
  description: string;
  /** Share image for link previews (WhatsApp, Instagram, X): a 1200×630 JPEG path in public/, or an absolute URL. */
  image?: string;
  imageAlt?: string;
  /** Open Graph type. */
  type?: "website" | "article";
  /** Absolute canonical URL. Default: this path on the hub. Course pages pass their own host's URL. */
  canonical?: string;
  /** Keep the page out of search. Default: while the demo runs. Preview builds are always noindex. */
  noindex?: boolean;
  /** Show the demo ribbon. Default: while the demo runs. */
  demo?: boolean;
  /** schema.org data for a JSON-LD block. */
  jsonLd?: unknown;
}

// The default share image is the main site's (feelingsbeautycare.in/og.jpg), copied to public/og.jpg.
const {
  title,
  description,
  image = "/og.jpg",
  imageAlt = "Feelings Beauty Care logo beside a bride in red with gold jewellery",
  type = "website",
  demo = course.demo,
  jsonLd,
} = Astro.props;
const canonical =
  Astro.props.canonical ?? new URL(Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "/") || "/", site.url).href;
const noindex = (Astro.props.noindex ?? course.demo) || isPreviewBuild(buildEnv);
// Link-preview crawlers need an absolute https URL (a path is resolved on the hub).
const imageUrl = new URL(image, site.url).href;
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* Demo content and preview builds stay out of search (functions/_lib/hosts.ts adds X-Robots-Tag on previews). */}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {/* Link previews. The noindex above doesn't stop WhatsApp, Instagram or X fetching these. */}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {jsonLd !== undefined && <script is:inline type="application/ld+json" set:html={jsonLdText(jsonLd)} />}
  </head>
  <body>
    {
      demo && (
        <aside class="demo-ribbon" aria-label="Demo notice">
          <p>Demo preview: the price and lessons are examples, and payments run in test mode. No real money is charged.</p>
        </aside>
      )
    }
    <slot />
  </body>
</html>

<style>
  .demo-ribbon {
    margin: 0;
    padding: 0.5rem 1rem;
    background: var(--maroon-800, var(--text));
    color: var(--bg);
    font-size: 0.8125rem;
    font-weight: var(--weight-ui);
    text-align: center;
  }

  .demo-ribbon p {
    margin: 0;
  }
</style>
