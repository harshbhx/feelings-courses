---
// The course admin's layout. Its own shell, not the landing page's: a top bar, a bottom tab bar on
// phones and tablets, a sidebar from 64rem (1024px). Always noindexed.
//
// Sign-in is real (W5's admin API): the page itself holds no data, every screen loads it from
// /api/admin/* with the HttpOnly admin cookie, and a 401 sends the owner to /admin (client/api.ts).
// The shell script checks the session, shows the payment-mode badge and the "Publish changes" chip.
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/motion.css";
import "../components/admin/admin.css";
import Icon from "../components/Icon.astro";
import Logo from "../components/landing/Logo.astro";
import IconSprite from "../components/admin/IconSprite.astro";
import { site } from "../data/site";
import { course } from "../data/course";

export type NavKey = "dashboard" | "courses" | "students" | "payments" | "coupons" | "settings" | "activity";

interface Props {
  title: string;
  active?: NavKey;
  /** The sign-in screen: no shell. */
  bare?: boolean;
  /** Hide the phone tab bar (a screen with its own bottom action bar). */
  noTabbar?: boolean;
  /** Extra icons the page's script builds markup with. */
  icons?: string[];
}

const { title, active, bare = false, noTabbar = false, icons = [] } = Astro.props;

const nav: { key: NavKey; href: string; label: string; icon: string; desktopOnly?: boolean }[] = [
  { key: "dashboard", href: "/admin/dashboard", label: "Dashboard", icon: "squares-four" },
  { key: "courses", href: "/admin/courses", label: "Courses", icon: "book-open-text" },
  { key: "students", href: "/admin/students", label: "Students", icon: "users-three" },
  { key: "payments", href: "/admin/payments", label: "Payments", icon: "credit-card" },
  { key: "coupons", href: "/admin/coupons", label: "Coupons", icon: "ticket" },
  { key: "activity", href: "/admin/activity", label: "Activity", icon: "list-checks", desktopOnly: true },
  { key: "settings", href: "/admin/settings", label: "Settings", icon: "gear-six", desktopOnly: true },
];
const owner = course.teacher;
const ownerInitials = owner
  .split(" ")
  .map((p) => p[0])
  .join("")
  .slice(0, 2);
// Icons every screen's script may use (states, dialogs, toasts).
const baseIcons = ["close", "check-circle", "info", "warning-circle", "arrow-counter-clockwise", "check", "copy", "arrow-square-out"];
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{`${title} · Course admin · ${site.name}`}</title>
    <meta name="description" content={`${title}: the course admin of ${site.name}, for courses, students, payments and settings.`} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="same-origin" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body class:list={["admin", { "no-tabbar": noTabbar }]}>
    <a class="skip-link" href="#main">Skip to content</a>
    {
      bare ? (
        <slot />
      ) : (
        <div class="shell">
          {/* An <aside>, so the brand and the footer links sit in a landmark too (screen readers list it). */}
          <aside class="sidebar" aria-label="Admin menu">
            <a class="side-brand" href="/admin/dashboard">
              <Logo width="8.75rem" />
              <span>Course admin</span>
            </a>
            <nav class="nav" aria-label="Admin">
              <ul>
                {nav.map((item) => (
                  <li class={item.desktopOnly ? "nav-desk" : undefined}>
                    <a href={item.href} aria-current={active === item.key ? "page" : undefined}>
                      <span class="nav-ic">
                        <Icon name={item.icon} />
                      </span>
                      <span class="nav-label">{item.label}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
            <div class="side-foot">
              <a class="side-link" href="/catalog">
                <Icon name="storefront" />
                Course catalog
              </a>
              <button class="side-link" type="button" data-signout>
                <Icon name="sign-out" />
                Sign out
              </button>
            </div>
          </aside>
          <div class="main-col">
            <header class="topbar">
              <a class="tb-app" href="/admin/dashboard">
                <img src="/favicon.svg" width="32" height="32" alt="" />
                <span>Course admin</span>
              </a>
              <p class="tb-crumb">
                {site.name}
                <span aria-hidden="true">/</span>
                <strong>Course admin</strong>
              </p>
              <div class="tb-right">
                <button class="publish-chip" type="button" data-publish-chip hidden>
                  <span class="chip-dot" aria-hidden="true" />
                  <span data-chip-label>Publish changes</span>
                </button>
                <a class="mode-badge" href="/admin/settings#payments" data-mode-badge hidden>
                  <span data-mode-label>Test mode</span>
                </a>
                <a
                  class="icon-btn tb-settings"
                  href="/admin/settings"
                  aria-label="Settings"
                  aria-current={active === "settings" ? "page" : undefined}
                >
                  <Icon name="gear-six" />
                </a>
                <span class="tb-user">
                  <span class="avatar" aria-hidden="true">{ownerInitials}</span>
                  <span>
                    <strong>{owner}</strong>
                    <span>Owner</span>
                  </span>
                </span>
              </div>
            </header>
            <main id="main" class="main" tabindex="-1">
              <p class="notice" data-setup-notice hidden>
                <Icon name="info" />
                <span>
                  The course platform isn't connected yet, so nothing can load. Harsh runs the one-time setup (npm run
                  setup); then this admin works.
                </span>
              </p>
              <slot />
            </main>
          </div>
        </div>
      )
    }
    <div id="toasts" class="toasts" aria-live="polite"></div>
    <p class="visually-hidden" aria-live="polite" data-announce></p>
    <IconSprite names={[...baseIcons, ...icons]} />
    {/* The shell script does nothing on the bare sign-in page (no .shell). */}
    <script>
      import "../components/admin/client/shell";
    </script>
  </body>
</html>
