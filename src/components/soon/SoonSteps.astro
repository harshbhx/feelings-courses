---
/**
 * How it will work, in three steps. Only the format is described (video lessons, on a phone, at
 * your own pace): no price, certificate or access period, since none is confirmed yet.
 */
import Icon from "../Icon.astro";
import { course } from "../../data/course";

const firstName = course.teacher.split(" ")[0];
const steps = [
  { icon: "whatsapp", title: "Get notified", text: `Send ${firstName} one WhatsApp message. You’ll hear when the first courses open.` },
  { icon: "list-checks", title: "Pick your course", text: "From self makeup and eye looks to bridal makeup, nail art and mehndi." },
  { icon: "device-mobile", title: "Learn at home", text: "Short video lessons on your phone or laptop, at your own pace." },
];
---

<section class="section how" id="how" aria-labelledby="how-title">
  <div class="container how-grid">
    <h2 id="how-title" data-reveal>How it will work<span class="bindi" aria-hidden="true"></span></h2>
    <ol class="steps" data-reveal="stagger">
      {
        steps.map((step, i) => (
          <li class="step" style={`--i: ${i}`}>
            <span class="step-mark" aria-hidden="true">
              <Icon name={step.icon} />
            </span>
            <span class="step-num">Step {i + 1}</span>
            <h3 class="step-title">{step.title}</h3>
            <p class="step-text">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .how-grid {
    display: grid;
    gap: var(--space-6);
  }

  .steps {
    list-style: none;
    display: grid;
  }

  /* Phones: a vertical line joins the steps. */
  .step {
    position: relative;
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    grid-template-areas:
      "mark num"
      "mark title"
      "mark text";
    column-gap: var(--space-4);
    align-content: start;
    padding-bottom: var(--space-6);
  }

  .step:not(:last-child)::before {
    content: "";
    position: absolute;
    left: 1.5rem;
    top: 3.25rem;
    bottom: var(--space-2);
    width: 1px;
    background: var(--border-strong);
  }

  .step:last-child {
    padding-bottom: 0;
  }

  .step-mark {
    grid-area: mark;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--bg-tint);
    color: var(--bg-deep);
  }

  .step-mark :global(.icon) {
    width: 1.4rem;
    height: 1.4rem;
  }

  .step-num {
    grid-area: num;
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .step-title {
    grid-area: title;
    font-size: var(--text-lg);
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .step-text {
    grid-area: text;
    margin-top: var(--space-1);
    max-width: 26em;
  }

  @media (min-width: 48rem) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-6);
    }

    .step {
      grid-template-columns: 1fr;
      grid-template-areas:
        "mark"
        "num"
        "title"
        "text";
      row-gap: var(--space-1);
      padding-bottom: 0;
    }

    .step-mark {
      margin-bottom: var(--space-4);
    }

    .step:not(:last-child)::before {
      left: 3.75rem;
      right: calc(var(--space-6) * -1 + var(--space-3));
      top: 1.5rem;
      bottom: auto;
      width: auto;
      height: 1px;
    }
  }

  @media (min-width: 64rem) {
    .how-grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      column-gap: var(--space-8);
      align-items: start;
    }
  }
</style>
