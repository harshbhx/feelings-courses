---
// The coupon form (DEMO): a native modal <dialog> using the shared .drawer, so it is a bottom sheet
// on phones and a side panel from 768px. coupons.ts fills it for a new or an existing code, checks
// it with checkCoupon() from src/lib/demo-store-coupons.ts and saves it.
import Icon from "../../Icon.astro";
import { CODE_MAX, CODE_MIN, PERCENT_MAX, PERCENT_MIN } from "../../../lib/demo-store-coupons";
---

<dialog class="drawer cpn-drawer" aria-labelledby="cpn-form-title" data-cpn-drawer>
  <form class="cpn-form" novalidate data-cpn-form>
    <div class="drawer-head cpn-form-head">
      <div>
        <h2 class="cpn-form-title" id="cpn-form-title" data-cpn-form-title>New coupon</h2>
        <p class="card-sub" data-cpn-form-sub>Demo: saved in this browser only.</p>
      </div>
      <button class="icon-btn" type="button" data-cpn-close aria-label="Close">
        <Icon name="close" />
      </button>
    </div>

    <div class="drawer-body cpn-form-body" data-cpn-form-body>
      <div class="error-summary" tabindex="-1" hidden aria-labelledby="cpn-summary-title" data-cpn-summary>
        <h2 id="cpn-summary-title">
          <Icon name="warning-circle" />
          <span data-cpn-summary-title>Check this to save</span>
        </h2>
        <ul data-cpn-summary-list></ul>
      </div>

      <div class="field">
        <label class="field-label" for="cpn-code">Code</label>
        <p class="field-hint" id="cpn-code-hint" data-cpn-code-hint>
          Capital letters and numbers, {CODE_MIN} to {CODE_MAX} characters. Buyers type it at checkout.
        </p>
        <input
          class="input cpn-code-input"
          id="cpn-code"
          name="code"
          type="text"
          autocomplete="off"
          autocapitalize="characters"
          spellcheck="false"
          aria-describedby="cpn-code-hint cpn-code-error"
          data-cpn-field="code"
        />
        <p class="field-error" id="cpn-code-error" data-cpn-error="code"></p>
        <p class="cpn-suggest" data-cpn-suggest-wrap>
          <span>For your next reel:</span>
          <button class="link-btn" type="button" data-cpn-suggest>Use REEL4</button>
        </p>
      </div>

      <fieldset class="cpn-fieldset">
        <legend class="field-label">Discount</legend>
        <div class="cpn-kind">
          <label class="cpn-kind-opt">
            <input type="radio" name="kind" value="percent" checked data-cpn-kind />
            <span><Icon name="percent" /> Percent off</span>
          </label>
          <label class="cpn-kind-opt">
            <input type="radio" name="kind" value="flat" data-cpn-kind />
            <span><Icon name="currency-inr" /> Rupees off</span>
          </label>
        </div>
        <div class="field">
          <label class="field-label" for="cpn-value" data-cpn-value-label>Percent off</label>
          <div class="input-affix cpn-value-wrap" data-cpn-value-wrap>
            <span class="affix affix-end" aria-hidden="true" data-cpn-affix>%</span>
            <input
              class="input pad-end cpn-value"
              id="cpn-value"
              name="value"
              type="text"
              inputmode="numeric"
              autocomplete="off"
              aria-describedby="cpn-value-hint cpn-value-error"
              data-cpn-field="value"
            />
          </div>
          <p class="field-hint" id="cpn-value-hint" data-cpn-value-hint>From {PERCENT_MIN}% to {PERCENT_MAX}%.</p>
          <p class="field-error" id="cpn-value-error" data-cpn-error="value"></p>
        </div>
      </fieldset>

      <div class="field">
        <label class="field-label" for="cpn-course">Works on</label>
        <select class="select" id="cpn-course" name="course" aria-describedby="cpn-course-error" data-cpn-field="courseId">
          <option value="">All courses</option>
        </select>
        <p class="field-error" id="cpn-course-error" data-cpn-error="courseId"></p>
      </div>

      <div class="form-grid cols-2 cpn-pair">
        <div class="field">
          <label class="field-label" for="cpn-expires">Last day <span class="opt">(optional)</span></label>
          <input
            class="input"
            id="cpn-expires"
            name="expires"
            type="date"
            aria-describedby="cpn-expires-hint cpn-expires-error"
            data-cpn-field="expires"
          />
          <p class="field-hint" id="cpn-expires-hint">Empty: the code never ends.</p>
          <p class="field-error" id="cpn-expires-error" data-cpn-error="expires"></p>
        </div>
        <div class="field">
          <label class="field-label" for="cpn-limit">Usage limit <span class="opt">(optional)</span></label>
          <input
            class="input"
            id="cpn-limit"
            name="limit"
            type="text"
            inputmode="numeric"
            autocomplete="off"
            aria-describedby="cpn-limit-hint cpn-limit-error"
            data-cpn-field="limit"
          />
          <p class="field-hint" id="cpn-limit-hint">Empty: no limit.</p>
          <p class="field-error" id="cpn-limit-error" data-cpn-error="limit"></p>
        </div>
      </div>

      <div class="cpn-active">
        <div>
          <p class="field-label" id="cpn-active-label">Turn on</p>
          <p class="field-hint" id="cpn-active-hint">Buyers can use it as soon as you save.</p>
        </div>
        <label class="switch">
          <input
            type="checkbox"
            role="switch"
            id="cpn-active"
            name="active"
            checked
            aria-labelledby="cpn-active-label"
            aria-describedby="cpn-active-hint"
            data-cpn-active
          />
          <span class="switch-track"></span>
        </label>
      </div>

      <div class="cpn-preview" data-cpn-preview>
        <span class="cpn-preview-ic"><Icon name="receipt" /></span>
        <div>
          <p class="cpn-preview-label">Buyers pay</p>
          <p class="cpn-preview-price" data-cpn-preview-price></p>
          <p class="cpn-preview-for" data-cpn-preview-for></p>
        </div>
      </div>
    </div>

    <div class="cpn-form-foot">
      <button class="btn btn-danger cpn-form-delete" type="button" hidden data-cpn-delete>
        <Icon name="trash" />
        Delete
      </button>
      <button class="btn btn-secondary" type="button" data-cpn-cancel>Cancel</button>
      <button class="btn btn-primary" type="submit" data-cpn-save>Save coupon</button>
    </div>
  </form>
</dialog>

<style is:global>
  /* The drawer is a column: head, a scrolling body, and the actions always in reach at the bottom. */
  .cpn-drawer[open] {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .cpn-form {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
  }

  .cpn-form-head {
    position: static;
    justify-content: space-between;
  }

  .cpn-form-head > div {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }

  .cpn-form-title {
    font-size: var(--text-lg);
    font-weight: var(--weight-display);
    letter-spacing: -0.02em;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .cpn-form-body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    gap: var(--space-5);
    padding-bottom: var(--space-5);
  }

  .cpn-form-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-5) calc(var(--space-3) + env(safe-area-inset-bottom));
    background: var(--bg);
    border-top: 1px solid var(--border);
  }

  .cpn-form-delete {
    margin-right: auto;
  }

  @media (max-width: 30rem) {
    .cpn-form-foot > .btn:not(.cpn-form-delete) {
      flex: 1 1 0;
    }

    .cpn-form-foot > .cpn-form-delete:not([hidden]) {
      flex: 1 1 100%;
      order: 3;
      margin-right: 0;
    }
  }

  /* The code looks like what buyers will type. */
  .cpn-code-input {
    font-weight: var(--weight-strong);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .cpn-code-input::placeholder {
    letter-spacing: 0;
    text-transform: none;
  }

  .cpn-suggest {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-2);
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-ui);
  }

  .cpn-suggest .link-btn {
    font-size: var(--text-sm);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 0.25em;
  }

  .cpn-fieldset {
    display: grid;
    gap: var(--space-3);
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .cpn-fieldset > legend {
    float: left;
    width: 100%;
    margin-bottom: var(--space-1);
    padding: 0;
  }

  /* Percent or rupees: two real radio buttons drawn as one segmented control. */
  .cpn-kind {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.25rem;
    padding: 0.25rem;
    border: 1px solid var(--border-control);
    border-radius: var(--radius-pill);
    background: var(--bg);
  }

  .cpn-kind-opt {
    position: relative;
    display: block;
    cursor: pointer;
  }

  .cpn-kind-opt input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .cpn-kind-opt span {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 2.5rem;
    padding: 0 0.75rem;
    border-radius: var(--radius-pill);
    color: var(--text-muted);
    font-weight: var(--weight-strong);
    transition: background-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }

  .cpn-kind-opt .icon {
    width: 1.05rem;
    height: 1.05rem;
  }

  .cpn-kind-opt input:checked + span {
    background: var(--bg-deep);
    color: var(--text-on-deep);
  }

  .cpn-kind-opt input:focus-visible + span {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  @media (hover: hover) {
    .cpn-kind-opt:hover input:not(:checked) + span {
      background: var(--bg-tint);
      color: var(--text);
    }
  }

  .cpn-value-wrap {
    max-width: 12rem;
  }

  .cpn-value {
    font-weight: var(--weight-strong);
    font-variant-numeric: tabular-nums;
  }

  .cpn-pair {
    gap: var(--space-5) var(--space-4);
  }

  .cpn-active {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .cpn-active > div {
    display: grid;
    gap: 0.15rem;
  }

  /* What buyers will pay: updates as the discount is typed. */
  .cpn-preview {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background: var(--bg-tint);
  }

  .cpn-preview-ic {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--bg);
    color: var(--maroon-800);
  }

  .cpn-preview > div {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }

  .cpn-preview-label {
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
  }

  .cpn-preview-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--space-2);
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .cpn-preview-price strong {
    font-size: var(--text-xl);
    font-weight: var(--weight-display);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .cpn-preview-price s {
    color: var(--text-muted);
    font-weight: var(--weight-ui);
  }

  .cpn-preview-price .cpn-preview-off {
    color: var(--maroon-800);
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
  }

  .cpn-preview-price.is-empty {
    font-size: var(--text-sm);
    font-weight: var(--weight-ui);
    color: var(--text-body);
  }

  .cpn-preview-for {
    color: var(--text-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-ui);
    overflow-wrap: anywhere;
  }
</style>
