---
// Studio profile (DEMO): name, WhatsApp number and address from src/data/site.ts, read-only here.
import Icon from "../../Icon.astro";
import { site } from "../../../data/site";

const a = site.address;
const address = `${a.street}\n${a.landmark}\n${a.city}, ${a.region} ${a.postalCode}`;
const mainHost = new URL(site.mainUrl).host;
---

<section class="card set-card" aria-labelledby="set-profile-title">
  <div class="card-head">
    <div>
      <h2 class="card-title" id="set-profile-title">Studio profile</h2>
      <p class="card-sub">The details buyers see for your studio.</p>
    </div>
    <span class="pill pill-plain set-lock">
      <Icon name="lock-simple" />
      Read-only
    </span>
  </div>
  <div class="card-pad set-body">
    <div class="form-grid cols-2">
      <div class="field">
        <label class="field-label" for="set-name">Studio name</label>
        <input class="input" id="set-name" type="text" value={site.name} readonly aria-describedby="set-profile-note" />
      </div>
      <div class="field">
        <label class="field-label" for="set-whatsapp">WhatsApp number</label>
        <input class="input set-tnum" id="set-whatsapp" type="tel" value={site.phone.display} readonly aria-describedby="set-profile-note" />
      </div>
      <div class="field span-all">
        <label class="field-label" for="set-address">Address</label>
        <textarea class="textarea set-address" id="set-address" rows="3" readonly aria-describedby="set-profile-note">{address}</textarea>
      </div>
    </div>
    <p class="set-note" id="set-profile-note">
      <Icon name="lock-simple" />
      <span>Editable in the real version. In this demo they come from your main website, {mainHost}.</span>
    </p>
  </div>
</section>
