---
// Notification switches (DEMO): saved in this browser by settings.ts; nothing is ever sent.
import { site } from "../../../data/site";
import { NOTIFY } from "./prefs";
---

<section class="card set-card" aria-labelledby="set-notify-title">
  <div class="card-head">
    <div>
      <h2 class="card-title" id="set-notify-title">Notifications</h2>
      <p class="card-sub">On WhatsApp to {site.phone.display}. Demo: nothing is sent.</p>
    </div>
  </div>
  <ul class="rows set-toggles">
    {
      NOTIFY.map((n) => (
        <li class="set-toggle">
          <label class="set-toggle-text" for={`set-n-${n.key}`}>
            <span class="set-toggle-title" id={`set-n-${n.key}-t`}>
              {n.title}
            </span>
            <span class="set-toggle-desc" id={`set-n-${n.key}-d`}>
              {n.text}
            </span>
          </label>
          <span class="switch">
            <input
              type="checkbox"
              role="switch"
              id={`set-n-${n.key}`}
              checked={n.on}
              aria-labelledby={`set-n-${n.key}-t`}
              aria-describedby={`set-n-${n.key}-d`}
              data-set-notify={n.key}
            />
            <span class="switch-track" />
          </span>
        </li>
      ))
    }
  </ul>
</section>
