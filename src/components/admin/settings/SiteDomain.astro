---
// The course site's address (from site.url in src/data/site.ts), with copy and open.
import Icon from "../../Icon.astro";
import { site } from "../../../data/site";

const host = new URL(site.url).host;
const mainHost = new URL(site.mainUrl).host;
---

<section class="card set-card" aria-labelledby="set-domain-title">
  <div class="card-head">
    <div>
      <h2 class="card-title" id="set-domain-title">Course site address</h2>
      <p class="card-sub">Where buyers open the course</p>
    </div>
  </div>
  <div class="card-pad set-body">
    <div class="set-domain">
      <span class="set-ic"><Icon name="link-simple" /></span>
      <a class="set-domain-link" href={site.url} target="_blank" rel="noopener">
        <span>{host}</span>
        <Icon name="arrow-square-out" />
        <span class="visually-hidden">(opens in a new tab)</span>
      </a>
      <button class="icon-btn set-copy" type="button" aria-label="Copy the course site address" data-set-copy={site.url}>
        <Icon name="copy" />
      </button>
    </div>
    <dl class="set-facts">
      <div>
        <dt>Main website</dt>
        <dd>
          <a href={site.mainUrl} target="_blank" rel="noopener">{mainHost}<span class="visually-hidden"> (opens in a new tab)</span></a>
        </dd>
      </div>
      <div>
        <dt>Hosting</dt>
        <dd>Cloudflare Pages, with HTTPS</dd>
      </div>
      <div>
        <dt>Google search</dt>
        <dd>Hidden while this is a demo</dd>
      </div>
    </dl>
  </div>
</section>
