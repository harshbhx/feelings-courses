---
// The modules and their lessons, each row a link with its number, title, minutes and a done tick.
// learn-ui.ts fills in the state from saved progress: data-state="done|next|todo" on each row and
// the "n of m done" counts. Without JavaScript every row reads as not started.
//
//   compact   the lesson page's outline: tighter rows, the open lesson marked with a bindi
//   current   slug of the open lesson (aria-current="page")
import Icon from "../Icon.astro";
import { formatMinutes, type LessonModule } from "../../data/lessons";

interface Props {
  modules: LessonModule[];
  current?: string;
  compact?: boolean;
}

const { modules, current, compact = false } = Astro.props;
---

<ol class:list={["modules", { compact }]}>
  {
    modules.map((mod) => (
      <li class="module" data-module>
        <div class="module-head">
          <p class="module-num">Module {mod.number}</p>
          <h3 class="module-title">{mod.title}</h3>
          <p class="module-meta">
            <span data-module-done>0</span> of {mod.lessons.length} done
            <span aria-hidden="true">·</span> {formatMinutes(mod.minutes)}
          </p>
        </div>
        <ol class="rows">
          {mod.lessons.map((lesson) => (
            <li>
              <a
                class="row"
                href={lesson.href}
                data-lesson={lesson.slug}
                data-title={lesson.title}
                data-meta={`Module ${mod.number} · Lesson ${lesson.number} · ${lesson.minutes} min`}
                data-number={lesson.number}
                data-state="todo"
                data-press
                aria-current={lesson.slug === current ? "page" : undefined}
              >
                <span class="mark" aria-hidden="true">
                  <span class="mark-num">{lesson.number}</span>
                  <Icon name="check-circle" class="icon mark-done" />
                </span>
                <span class="row-text">
                  <span class="row-title">
                    {lesson.title}
                    {lesson.slug === current && <span class="bindi" />}
                  </span>
                  <span class="row-meta">
                    <Icon name="clock" class="icon row-clock" />
                    {lesson.minutes} min
                    <span class="row-next" aria-hidden="true">
                      Up next
                    </span>
                  </span>
                  <span class="visually-hidden" data-lesson-status />
                </span>
                <Icon name="caret-right" class="icon row-go" />
              </a>
            </li>
          ))}
        </ol>
      </li>
    ))
  }
</ol>

<style>
  .modules {
    list-style: none;
    display: grid;
    gap: var(--space-5);
  }

  .module {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg);
    overflow: hidden;
  }

  .module-head {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-4) var(--space-3);
  }

  .module-num {
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .module-title {
    font-size: var(--text-xl);
    font-weight: var(--weight-strong);
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .module-meta {
    font-size: var(--text-sm);
    font-weight: var(--weight-ui);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .rows {
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .rows > li + li {
    border-top: 1px solid var(--border);
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-4);
    min-height: 4rem;
    padding: var(--space-3) var(--space-4);
    color: var(--text);
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .row:hover {
    background: var(--bg-soft);
  }

  .row:focus-visible {
    outline-offset: -3px;
  }

  /* Number in a ring; a maroon tick once done. */
  .mark {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1.5px solid var(--border-control);
    border-radius: 50%;
    font-size: var(--text-sm);
    font-weight: var(--weight-strong);
    color: var(--text-body);
    font-variant-numeric: tabular-nums;
  }

  .mark :global(.mark-done) {
    position: absolute;
    inset: -1.5px;
    width: calc(100% + 3px);
    height: calc(100% + 3px);
    color: var(--bg-deep);
    opacity: 0;
  }

  .row[data-state="done"] .mark {
    border-color: transparent;
  }

  .row[data-state="done"] .mark-num {
    opacity: 0;
  }

  .row[data-state="done"] :global(.mark-done) {
    opacity: 1;
  }

  .row[data-state="next"] .mark {
    border-color: var(--text);
    color: var(--text);
  }

  .row-text {
    display: grid;
    gap: 0.125rem;
    min-width: 0;
  }

  .row-title {
    font-weight: var(--weight-strong);
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .row-meta {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-ui);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .row-meta :global(.row-clock) {
    width: 1em;
    height: 1em;
  }

  .row-next {
    display: none;
    padding: 0.05rem 0.55rem;
    border-radius: var(--radius-pill);
    background: var(--bg-tint);
    color: var(--text);
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
  }

  .row[data-state="next"] .row-next {
    display: inline-block;
  }

  .row :global(.row-go) {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--text-muted);
    transition: transform var(--dur-fast) var(--ease-out);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .row:hover :global(.row-go) {
      transform: translateX(2px);
    }
  }

  /* The open lesson, in the lesson page's outline. */
  .row[aria-current="page"] {
    background: var(--bg-tint);
  }

  .row[aria-current="page"] :global(.row-go) {
    visibility: hidden;
  }

  .row .bindi {
    width: 0.32em;
    height: 0.32em;
    margin-left: 0.3em;
  }

  /* ── Compact: the outline beside (or under) a lesson. One box (the outline's), so the modules
     are bands split by hairlines rather than cards inside a card. ── */
  .compact {
    gap: 0;
  }

  .compact .module {
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  .compact .module + .module {
    border-top: 1px solid var(--border);
  }

  .compact .module-head {
    gap: 0;
    padding: var(--space-4) var(--space-4) var(--space-2);
  }

  .compact .module-num {
    font-size: var(--text-xs);
  }

  .compact .module-title {
    font-size: var(--text-base);
  }

  .compact .module-meta {
    display: none;
  }

  .compact .rows,
  .compact .rows > li + li {
    border-top: 0;
  }

  .compact .row {
    gap: var(--space-3);
    min-height: 3rem;
    padding: var(--space-2) var(--space-4);
  }

  .compact .mark {
    width: 1.75rem;
    height: 1.75rem;
    font-size: var(--text-xs);
  }

  .compact .row-title {
    font-size: var(--text-sm);
  }

  .compact .row-meta {
    font-size: var(--text-xs);
  }

  /* You are on it: no "Up next" chip on the open lesson. */
  .row[aria-current="page"] .row-next {
    display: none;
  }

  @media (min-width: 48rem) {
    .module-head {
      padding: var(--space-5) var(--space-5) var(--space-4);
    }

    .row {
      padding-inline: var(--space-5);
    }

    .compact .module-head {
      padding: var(--space-4) var(--space-4) var(--space-2);
    }

    .compact .row {
      padding-inline: var(--space-4);
    }
  }
</style>
