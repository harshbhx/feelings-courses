---
// The course area's footer: where progress is kept and logging out of this device, on a soft band,
// then the site's compact footer (the studio, the main links, policies), as on every other page.
import Footer from "../landing/Footer.astro";
---

<section class="learn-device" aria-label="This device">
  <div class="container inner">
    <p class="saved">Your ticks are saved in this browser, on this device only.</p>
    <details class="logout">
      <summary>Log out of this device</summary>
      <div class="logout-body">
        <p>This removes your course access from this browser. Your ticks stay.</p>
        <form method="post" action="/learn/logout">
          <button class="btn btn-secondary btn-sm" type="submit">Log out</button>
        </form>
      </div>
    </details>
  </div>
</section>
<Footer variant="compact" bleed={false} />

<style>
  .learn-device {
    margin-top: var(--space-8);
    padding-block: var(--space-5);
    border-top: 1px solid var(--border);
    background: var(--bg-soft);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .inner {
    display: grid;
    gap: var(--space-3);
  }

  .saved {
    margin: 0;
  }

  .logout summary {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--text);
    font-weight: var(--weight-ui);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 0.2em;
    cursor: pointer;
    list-style: none;
  }

  .logout summary::-webkit-details-marker {
    display: none;
  }

  .logout-body {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
    padding-bottom: var(--space-2);
  }

  @media (min-width: 64rem) {
    .inner {
      grid-template-columns: 1fr auto;
      align-items: center;
      column-gap: var(--space-7);
    }
  }
</style>
