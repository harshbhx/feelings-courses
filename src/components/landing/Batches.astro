---
/**
 * Studio batches (#batches) for in-person and hybrid courses: the open batches from the snapshot,
 * soonest first. Each one is a ticket: a calendar leaf with its start day, the dates and schedule,
 * its price (a batch may have its own), the seats left and a "Book this batch" button that opens
 * the checkout with that batch already picked. A full batch stays listed, marked Full, with a
 * WhatsApp line about the next one, so the visitor sees when it is.
 *
 * Seats are as of the last build; the checkout re-checks them on the server (W2), so this list
 * never promises a seat. Few seats (FEW_SEATS or fewer) take the accent: a real count, never a
 * timer. Without open batches the section says so and offers WhatsApp.
 */
import Icon from "../Icon.astro";
import { site } from "../../data/site";
import { whatsappLink } from "../../lib/whatsapp";
import { batchDates, dayParts, FEW_SEATS, formatInr, seatsLabel, type CourseView } from "../../lib/course-view";

interface Props {
  view: CourseView;
}

const { view } = Astro.props;
const { course } = view;
const ask = whatsappLink(`Hi ${view.teacherFirstName}, when is the next batch of the ${course.title}?`);
---

<section class="section batches" id="batches" aria-labelledby="batches-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <h2 id="batches-title">Batch dates<span class="bindi" aria-hidden="true"></span></h2>
      <p class="lead">
        Classes at {site.name}, {site.address.city}, in small batches.
        {view.depositDisplay ? ` Book a seat with ${view.depositDisplay}; the rest is paid at the studio.` : " Pick a batch when you book."}
      </p>
    </div>

    {
      course.batches.length > 0 ? (
        <ul class="batch-list" data-reveal="stagger">
          {course.batches.map((b, i) => {
            const seats = seatsLabel(b);
            const full = b.seatsLeft === 0;
            const few = !full && b.seatsLeft !== null && b.seatsLeft <= FEW_SEATS;
            const leaf = dayParts(b.startsOn);
            return (
              <li class:list={["batch", { "is-full": full }]} style={`--i: ${i}`}>
                {leaf && (
                  <span class="leaf" aria-hidden="true">
                    <span class="leaf-month">{leaf.month}</span>
                    <span class="leaf-day">{leaf.day}</span>
                    <span class="leaf-week">{leaf.weekday}</span>
                  </span>
                )}
                <span class="batch-main">
                  <h3 class="batch-title">{b.title}</h3>
                  <span class="batch-line">
                    <Icon name="calendar-blank" />
                    {batchDates(b)}
                  </span>
                  {b.scheduleText && (
                    <span class="batch-line">
                      <Icon name="clock" />
                      {b.scheduleText}
                    </span>
                  )}
                </span>
                <span class="batch-foot">
                  <span class="batch-price">
                    {formatInr(b.pricePaise ?? course.pricePaise)}
                    {seats && <span class:list={["batch-seats", { "is-few": few, "is-full": full }]}>{seats}</span>}
                  </span>
                  {full ? (
                    <a class="batch-ask" href={ask} target="_blank" rel="noopener">
                      <Icon name="whatsapp" />
                      Ask about the next one
                    </a>
                  ) : (
                    <a class="btn btn-secondary batch-book" href="#pricing" data-enroll data-batch={b.id}>
                      Book this batch
                      <span class="visually-hidden">, {batchDates(b)}</span>
                      <Icon name="arrow-right" />
                    </a>
                  )}
                </span>
              </li>
            );
          })}
        </ul>
      ) : (
        <p class="batch-none" data-reveal>
          <Icon name="calendar-blank" />
          <span>
            No batch is open for booking right now.{" "}
            <a href={ask} target="_blank" rel="noopener">
              Ask about the next one on WhatsApp
            </a>
            .
          </span>
        </p>
      )
    }
  </div>
</section>

<style>
  .batch-list {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .batch-list {
      grid-template-columns: repeat(auto-fill, minmax(21rem, 1fr));
    }
  }

  .batch {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
      "leaf main"
      "foot foot";
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--bg);
    box-shadow: var(--shadow-sm);
  }

  /* A full batch steps back: no shadow, a dashed edge, quieter text. */
  .batch.is-full {
    border-style: dashed;
    background: var(--bg-soft);
    box-shadow: none;
  }

  .batch.is-full .leaf,
  .batch.is-full .batch-main {
    opacity: 0.72;
  }

  /* ── The calendar leaf ── */
  .leaf {
    grid-area: leaf;
    display: grid;
    justify-items: center;
    align-self: start;
    width: 4rem;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--bg);
    text-align: center;
  }

  .leaf-month {
    width: 100%;
    padding-block: 0.15rem;
    background: var(--bg-deep);
    color: var(--text-on-deep);
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
    line-height: 1.4;
  }

  .is-full .leaf-month {
    background: var(--text-muted);
  }

  .leaf-day {
    padding-top: 0.3rem;
    color: var(--text);
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: var(--weight-display);
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .leaf-week {
    padding-bottom: 0.3rem;
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-ui);
  }

  /* ── Words ── */
  .batch-main {
    grid-area: main;
    display: grid;
    align-content: start;
    gap: var(--space-1);
    min-width: 0;
  }

  .batch-title {
    margin-bottom: var(--space-1);
    color: var(--text);
    font-size: var(--text-lg);
    font-weight: var(--weight-strong);
    line-height: var(--leading-snug);
  }

  .batch-line {
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
    color: var(--text-body);
    font-size: var(--text-sm);
    line-height: 1.45;
  }

  .batch-line :global(.icon) {
    flex: none;
    width: 1.1em;
    height: 1.1em;
    margin-top: 0.15em;
    color: var(--text-muted);
  }

  .batch-foot {
    grid-area: foot;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
  }

  .batch-price {
    display: grid;
    color: var(--text);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-display);
    letter-spacing: -0.02em;
    line-height: 1.15;
    font-variant-numeric: tabular-nums;
  }

  .batch-seats {
    color: var(--text-muted);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-ui);
    letter-spacing: 0;
  }

  .batch-seats.is-few,
  .batch-seats.is-full {
    color: var(--accent);
  }

  .batch-book {
    min-height: 2.75rem;
    padding-inline: 1.1rem;
    font-size: var(--text-sm);
  }

  .batch-ask {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    color: var(--text);
    font-size: var(--text-sm);
    font-weight: var(--weight-ui);
  }

  .batch-ask :global(.icon) {
    color: var(--bg-deep);
  }

  .batch-none {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    max-width: 36rem;
    margin-top: var(--space-5);
    padding: var(--space-4) var(--space-5);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--bg-soft);
    color: var(--text-body);
  }

  .batch-none :global(.icon) {
    flex: none;
    width: 1.4rem;
    height: 1.4rem;
    margin-top: 0.15rem;
    color: var(--bg-deep);
  }
</style>
