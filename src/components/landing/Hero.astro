---
/**
 * Hero: the course, its key facts and the price on the first screen, with a glimpse to tap.
 *
 * Phones: the words and the enroll button first, then the glimpse as a large 4:5 cover (the
 * shape of an Instagram post; it opens to 9:16 when played). From 48rem: the words on the left and
 * the glimpse as a tall 9:16 reel on the right, sized so the whole card fits the first screen.
 *
 * The glimpse is the first clip in the course's glimpses (its promo video, once it exists).
 * Its cover is the page's largest paint, so it loads eagerly and is never faded in.
 *
 * Every fact comes from the course's snapshot entry (src/lib/course-view.ts words it).
 */
import { getImage } from "astro:assets";
import Icon from "../Icon.astro";
import Reel from "./Reel.astro";
import portrait from "../../assets/photos/urmi-mengar.webp";
import { site } from "../../data/site";
import { batchDates, dayParts, FEW_SEATS, nextOpenBatch, seatsLabel, type CourseView } from "../../lib/course-view";
import { ratingCount, ratingMonth } from "./facts";

interface Props {
  view: CourseView;
}

const { view } = Astro.props;
const { course } = view;
// Key facts as big numerals, like the counts on an Instagram profile.
const stats = view.stats;

const promo = course.details.glimpses[0];
const words = course.title.split(" ");

// Studio courses: the soonest batch with a seat, shown under the button and on the picture.
const next = view.hasBatches ? nextOpenBatch(course.batches) : null;
const nextDay = next ? dayParts(next.startsOn) : null;
const nextSeats = next ? seatsLabel(next) : null;
const fewSeats = next?.seatsLeft != null && next.seatsLeft <= FEW_SEATS;

// Without a glimpse: the admin's cover image, else (the founder's courses) her cut-out portrait
// on a blush card with the next batch pinned to it, like a ticket. Another teacher's course
// without either keeps the words alone.
const fallbackSizes = "(min-width: 48rem) 22rem, calc(100vw - 2.5rem)";
const fallback = promo
  ? null
  : course.coverUrl
    ? { kind: "cover" as const, src: course.coverUrl }
    : course.teacher === site.founder
      ? { kind: "portrait" as const, image: await getImage({ src: portrait, widths: [360, 540, 720], sizes: fallbackSizes, format: "webp", quality: 74 }) }
      : null;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-text">
      <p class="eyebrow enter">{view.eyebrow}</p>
      <h1 id="hero-title" class="hero-title words">
        {
          words.map((word, i) => (
            <>
              {/* One line, so no space falls between the last word and its bindi. */}
              <span style={`--w: ${i}`}>{word}{i === words.length - 1 && <span class="bindi" aria-hidden="true" />}</span>
              {i < words.length - 1 && " "}
            </>
          ))
        }
      </h1>
      {course.subtitle && <p class="lead hero-lead enter" style="--i: 1">{course.subtitle}</p>}

      <div class="glance enter" style="--i: 2">
        <ul class="stats" aria-label="The course at a glance">
          {
            stats.map((s) => (
              <li>
                <span class="stat-value">{s.value}</span>
                <span class="stat-unit">{s.unit}</span>
              </li>
            ))
          }
        </ul>
        <ul class="extras">
          {course.certificateTitle && <li><Icon name="certificate" />Certificate</li>}
          {course.language && <li><Icon name="translate" />{course.language}</li>}
        </ul>
      </div>

      <div class="hero-actions enter" style="--i: 3" data-cta-zone="hero">
        <a class="btn btn-primary hero-enroll" href="#pricing" data-enroll>
          {view.enrollLabel}
          <Icon name="arrow-right" />
        </a>
        {
          view.hasBatches && course.batches.length > 0 ? (
            <a class="link-arrow hero-lessons" href="#batches">See batch dates</a>
          ) : (
            view.lessonCount > 0 && <a class="link-arrow hero-lessons" href="#curriculum">See all {view.lessonCount} lessons</a>
          )
        }
      </div>
      {
        next && (
          <p class="hero-next enter" style="--i: 4">
            <Icon name="calendar-check" />
            <span>
              Next batch: <strong>{batchDates(next)}</strong>
              {next.scheduleText && <span class="hero-next-sub">{next.scheduleText}</span>}
            </span>
            {nextSeats && <span class:list={["hero-seats", { "is-few": fewSeats }]}>{nextSeats}</span>}
          </p>
        )
      }
      <p class="hero-rating enter" style="--i: 4">
        <Icon name="star-fill" />
        <span>
          <strong>{site.googleRating.rating}</strong> from {ratingCount} Google reviews of the studio
          <span class="nowrap">({ratingMonth})</span>
        </span>
      </p>
    </div>

    {
      promo && (
        <div class="hero-media">
          <div class="hero-reel">
            <Reel
              id={promo.youtubeId}
              label={promo.label}
              eager
              sizes="(min-width: 48rem) min(32vw, 22rem), calc(100vw - 2.5rem)"
              widths={[360, 540, 720]}
            />
          </div>
          <p class="hero-caption">
            <Icon name="play-fill" />
            <span>
              <span class="visually-hidden">Video: </span>
              {promo.label}
            </span>
          </p>
        </div>
      )
    }
    {
      fallback && (
        <div class="hero-media hero-still">
          <div class:list={["still-card", `still-${fallback.kind}`]}>
            {fallback.kind === "cover" ? (
              <img src={fallback.src} alt="" width="720" height="900" decoding="async" fetchpriority="high" />
            ) : (
              <img
                src={fallback.image.src}
                srcset={fallback.image.srcSet.attribute}
                sizes={fallbackSizes}
                alt={`${course.teacher}, who teaches this course`}
                width={portrait.width}
                height={portrait.height}
                decoding="async"
                fetchpriority="high"
              />
            )}
            {next && nextDay ? (
              <p class="still-ticket">
                <span class="ticket-leaf" aria-hidden="true">
                  <span class="leaf-month">{nextDay.month}</span>
                  <span class="leaf-day">{nextDay.day}</span>
                </span>
                <span class="ticket-text">
                  <strong>{next.title}</strong>
                  <span>{nextSeats ?? (view.hasLessons ? "Studio batch" : "Open for booking")}</span>
                </span>
              </p>
            ) : (
              <p class="still-ticket still-place">
                <Icon name="map-pin" />
                <span class="ticket-text">
                  <strong>{site.name}</strong>
                  <span>{site.address.city}</span>
                </span>
              </p>
            )}
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    overflow-x: clip;
    padding-block: var(--space-5) var(--section-y-tight);
  }

  .hero-grid {
    display: grid;
    gap: var(--space-7);
  }

  .hero-text {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    min-width: 0;
  }

  .hero-text .eyebrow {
    color: var(--accent);
  }

  /* 44px on a 390px phone, up to 68px: two lines on every screen. */
  .hero-title {
    font-size: clamp(2.75rem, 1.8rem + 3.9vw, 4.25rem);
    margin-top: calc(var(--space-2) * -1);
  }

  .hero-lead {
    max-width: 30em;
  }

  /* ── At a glance: three big numerals between hairlines, then the certificate and language ── */
  .glance {
    display: grid;
    gap: var(--space-4);
    width: 100%;
    max-width: 30rem;
  }

  .stats {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block: 1px solid var(--border-strong);
  }

  .stats li {
    display: grid;
    gap: 0.35rem;
    align-content: start;
    padding: var(--space-4) var(--space-1) var(--space-4) var(--space-4);
  }

  .stats li:first-child {
    padding-left: 0;
  }

  .stats li + li {
    border-left: 1px solid var(--border-strong);
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.45rem + 1.2vw, 2.25rem);
    font-weight: var(--weight-display);
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .stat-unit {
    font-size: var(--text-xs);
    font-weight: var(--weight-ui);
    line-height: 1.3;
    color: var(--text-muted);
  }

  .extras {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    font-size: var(--text-sm);
    font-weight: var(--weight-ui);
    line-height: 1.35;
    color: var(--text);
  }

  .extras li {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
  }

  .extras :global(.icon) {
    width: 1.2em;
    height: 1.2em;
    color: var(--bg-deep);
  }

  /* The studio's confirmed Google rating, right under the button. */
  .hero-rating {
    margin-top: calc(var(--space-2) * -1);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--text-muted);
    text-wrap: balance;
  }

  .hero-rating strong {
    font-weight: var(--weight-strong);
    color: var(--text);
  }

  .hero-rating :global(.icon) {
    display: inline-block;
    width: 1.05rem;
    height: 1.05rem;
    margin-right: 0.3em;
    vertical-align: -0.17em;
    color: var(--bg-deep);
  }

  .nowrap {
    white-space: nowrap;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    width: 100%;
    margin-top: var(--space-2);
  }

  .hero-enroll {
    min-height: 3.375rem;
    padding-inline: 1.75rem;
    font-size: var(--text-lg);
    box-shadow: var(--shadow-accent);
  }

  @media (max-width: 29.99rem) {
    .hero-enroll {
      flex: 1 1 100%;
    }

    .hero-lessons {
      display: none;
    }

    .hero-rating {
      width: 100%;
      text-align: center;
    }
  }

  /* ── The glimpse ── */
  .hero-media {
    position: relative;
    isolation: isolate;
    min-width: 0;
    --reel-ratio: 4 / 5;
    --reel-pos: 50% 6%;
    --reel-radius: var(--radius-lg);
  }

  .hero-caption {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--weight-ui);
    color: var(--text-muted);
  }

  .hero-caption :global(.icon) {
    width: 0.85em;
    height: 0.85em;
    color: var(--bg-deep);
  }

  @media (min-width: 48rem) {
    .hero {
      padding-top: var(--space-6);
    }

    .hero-grid {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      column-gap: clamp(var(--space-6), 5vw, var(--space-9));
    }

    /* A tall reel, never taller than the first screen leaves room for. */
    .hero-media {
      --reel-ratio: 9 / 16;
      --reel-pos: 50% 50%;
      width: clamp(15rem, min(32vw, (100vh - 13rem) * 0.5625), 22rem);
      margin-right: var(--space-5);
    }

    /* A blush card offset behind the reel, like the next one in a stack: depth from a flat
       tint, no shadow or gradient. */
    .hero-reel {
      position: relative;
    }

    .hero-reel::before {
      content: "";
      position: absolute;
      z-index: -1;
      inset: var(--space-5) calc(var(--space-5) * -1) calc(var(--space-5) * -1) var(--space-5);
      border-radius: var(--radius-lg);
      background: var(--bg-tint);
    }

    .hero-caption {
      margin-top: var(--space-6);
    }
  }

  @media (min-width: 64rem) {
    .hero {
      padding-top: var(--space-7);
    }
  }
  /* ── The next batch, under the button ── */
  .hero-next {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    width: 100%;
    max-width: 30rem;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--bg-soft);
    color: var(--text-body);
    font-size: var(--text-sm);
    line-height: 1.4;
  }

  .hero-next > :global(.icon) {
    width: 1.35rem;
    height: 1.35rem;
    color: var(--bg-deep);
  }

  .hero-next > span:not(.hero-seats) {
    display: grid;
    flex: 1 1 12rem;
  }

  .hero-next strong {
    color: var(--text);
    font-weight: var(--weight-strong);
  }

  .hero-next-sub {
    color: var(--text-muted);
  }

  .hero-seats {
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-pill);
    background: var(--bg);
    color: var(--text-muted);
    font-weight: var(--weight-ui);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .hero-seats.is-few {
    color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--border-strong);
  }

  /* ── No glimpse: a still picture card ── */
  .still-card {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--bg-tint);
  }

  .still-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The cut-out stands on the card's bottom edge. */
  .still-portrait img {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: auto;
    height: 94%;
    max-width: none;
    translate: -50% 0;
  }

  /* A white ticket pinned to the picture's bottom-left corner: a calendar leaf and the batch. */
  .still-ticket {
    position: absolute;
    left: var(--space-4);
    right: var(--space-4);
    bottom: var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    max-width: 17rem;
    padding: var(--space-3);
    border-radius: var(--radius-md);
    background: var(--bg);
    box-shadow: var(--shadow-md);
  }

  .ticket-leaf {
    display: grid;
    flex: none;
    justify-items: center;
    width: 3.25rem;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    text-align: center;
  }

  .leaf-month {
    width: 100%;
    padding-block: 0.1rem;
    background: var(--accent);
    color: var(--on-accent);
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
    line-height: 1.4;
  }

  .leaf-day {
    padding-block: 0.15rem 0.25rem;
    color: var(--text);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-display);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .ticket-text {
    display: grid;
    min-width: 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: 1.35;
  }

  .ticket-text strong {
    color: var(--text);
    font-weight: var(--weight-strong);
  }

  .still-place > :global(.icon) {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .still-ticket {
      animation: ticket-in 620ms var(--ease-soft) 360ms both;
    }

    @keyframes ticket-in {
      from {
        opacity: 0;
        transform: translate3d(0, 14px, 0);
      }
    }
  }

  @media (min-width: 48rem) {
    /* The still card takes the reel's place and shape. */
    .hero-still .still-card {
      aspect-ratio: 4 / 5;
    }

    .hero-still {
      width: clamp(16rem, min(34vw, (100vh - 12rem) * 0.8), 24rem);
    }
  }
</style>
