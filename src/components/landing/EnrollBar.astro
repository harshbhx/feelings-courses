---
/**
 * Phone enroll bar (below 48rem): the price and a red "Enroll" button, fixed to the bottom.
 * It slides up once the hero's enroll button has scrolled away, and steps aside while any other
 * block with an enroll button ([data-cta-zone]: the price card, the closing call to action) is on
 * screen, so a view never shows two red buttons. An IntersectionObserver does all the measuring.
 * Without JS it stays hidden: the page's own buttons still work.
 */
import { course } from "../../data/course";
import { accessLabel, lessonsLabel } from "./facts";
---

<aside class="enroll-bar" aria-label="Enroll" data-enroll-bar>
  <div class="bar-inner">
    <p class="bar-text">
      <span class="bar-price">{course.price.display}</span>
      <span class="bar-meta">{lessonsLabel} · {accessLabel}</span>
    </p>
    <a class="btn btn-primary bar-enroll" href="#pricing" data-enroll>Enroll</a>
  </div>
</aside>

<script>
  const bar = document.querySelector<HTMLElement>("[data-enroll-bar]");
  const zones = Array.from(document.querySelectorAll<HTMLElement>("[data-cta-zone]"));
  const hero = document.querySelector<HTMLElement>('[data-cta-zone="hero"]');

  if (bar && hero && "IntersectionObserver" in window) {
    const visible = new Set<Element>();
    let heroPassed = false;

    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) visible.add(entry.target);
        else visible.delete(entry.target);
        // The hero's button has scrolled away upwards (not merely below a short first screen).
        if (entry.target === hero) heroPassed = !entry.isIntersecting && entry.boundingClientRect.bottom <= 0;
      }
      bar.classList.toggle("is-shown", heroPassed && visible.size === 0);
    });
    zones.forEach((zone) => observer.observe(zone));
  }
</script>

<style>
  .enroll-bar {
    position: fixed;
    inset: auto 0 0;
    z-index: 40;
    padding: var(--space-3) var(--gutter) calc(var(--space-3) + env(safe-area-inset-bottom));
    border-top: 1px solid var(--border);
    background: var(--bg-glass);
    box-shadow: var(--shadow-header);
    transform: translateY(calc(100% + 1px));
    visibility: hidden;
    transition:
      transform 320ms var(--ease-soft),
      visibility 0s linear 320ms;
  }

  .enroll-bar.is-shown {
    transform: none;
    visibility: visible;
    transition:
      transform 420ms var(--ease-soft),
      visibility 0s linear 0s;
  }

  .bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: calc(var(--mobile-bar-h) - var(--space-3) * 2);
  }

  .bar-text {
    display: grid;
    min-width: 0;
    line-height: 1.2;
  }

  .bar-price {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-display);
    letter-spacing: -0.02em;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .bar-meta {
    overflow: hidden;
    font-size: var(--text-xs);
    font-weight: var(--weight-ui);
    color: var(--text-muted);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .bar-enroll {
    flex: none;
    min-width: 8.5rem;
    min-height: 3rem;
  }

  @media (min-width: 48rem) {
    .enroll-bar {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .enroll-bar,
    .enroll-bar.is-shown {
      transition: none;
    }
  }
</style>
