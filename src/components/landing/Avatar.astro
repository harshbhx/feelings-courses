---
// Urmi's face in a small circle: a square crop (urmi-mengar-face.webp) of the same cut-out
// portrait the main site uses as Urmi on its About page. For the "ask Urmi" moments.
import { getImage } from "astro:assets";
import face from "../../assets/photos/urmi-mengar-face.webp";
import { course } from "../../data/course";

interface Props {
  /** Rendered size, any CSS length (it also sets the srcset's sizes). */
  size?: string;
  /** Decorative when the text beside it already names Urmi. */
  decorative?: boolean;
  class?: string;
}

const { size = "3rem", decorative = true, class: className } = Astro.props;
const widths = [96, 160, 240];
const [avif, webp] = await Promise.all([
  getImage({ src: face, widths, sizes: size, format: "avif", quality: 55 }),
  getImage({ src: face, widths, sizes: size, format: "webp", quality: 75 }),
]);
---

<span class:list={["avatar", className]} style={`--avatar-size: ${size}`}>
  <picture>
    <source type="image/avif" srcset={avif.srcSet.attribute} sizes={size} />
    <img
      src={webp.src}
      srcset={webp.srcSet.attribute}
      sizes={size}
      width={face.width}
      height={face.height}
      alt={decorative ? "" : course.teacher}
      loading="lazy"
      decoding="async"
    />
  </picture>
</span>

<style>
  .avatar {
    display: inline-block;
    flex: none;
    width: var(--avatar-size);
    height: var(--avatar-size);
    overflow: hidden;
    border-radius: 50%;
    background: var(--bg-tint);
  }

  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
