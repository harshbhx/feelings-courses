---
/**
 * One course's landing page, from its snapshot entry: the same sections the demo landing page had,
 * worded for the course's format (recorded lessons, studio batches, or both).
 *
 * Rendered at /c/<slug> on the hub for every published course; functions/_lib/hosts.ts serves that
 * page at <slug>.feelingsbeautycare.in/ once the domain is attached. The hub's / renders it too
 * while only one course is published (the page Instagram links point at today).
 *
 * Checkout: the demo's <Checkout /> (W0/W2, src/components/checkout) charges the demo course from
 * src/data/course.ts, so it is mounted only for example content. Real courses get W2's live
 * checkout (CheckoutProps = { course, settings }); until then their Enroll buttons lead to the
 * price card and a WhatsApp booking note.
 */
import Base from "../../layouts/Base.astro";
import Reveal from "./Reveal.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import Glimpses from "./Glimpses.astro";
import Curriculum from "./Curriculum.astro";
import Batches from "./Batches.astro";
import Teacher from "./Teacher.astro";
import ForWho from "./ForWho.astro";
import Pricing from "./Pricing.astro";
import Faq from "./Faq.astro";
import FinalCta from "./FinalCta.astro";
import EnrollBar from "./EnrollBar.astro";
import Footer from "./Footer.astro";
import Checkout from "../checkout/Checkout.astro";
import { site } from "../../data/site";
import { buildEnv } from "../../lib/build-env";
import { courseView } from "../../lib/course-view";
import { courseDescription, courseIndexable, courseJsonLd, courseTitle } from "../../lib/seo";
import { whatsappLink } from "../../lib/whatsapp";
import type { PublicCourse, PublicSettings } from "../../shared/types";

interface Props {
  course: PublicCourse;
  settings: PublicSettings;
}

const { course, settings } = Astro.props;
const view = courseView(course);
const details = course.details;
const showCurriculum = details.outcomes.length > 0 || course.modules.some((m) => m.lessons.length > 0);
// The portrait and the studio's facts belong to the founder; another teacher gets no such section.
const showTeacher = course.teacher === site.founder;
---

<Base
  title={courseTitle(course, settings.business.name || site.name)}
  description={courseDescription(course)}
  canonical={course.canonicalUrl}
  noindex={!courseIndexable(course, buildEnv)}
  demo={course.isDemo}
  image={course.ogImageUrl ?? undefined}
  imageAlt={course.ogImageUrl ? course.title : undefined}
  jsonLd={courseJsonLd(course, settings.business)}
>
  <Reveal />
  <a class="skip-link" href="#main">Skip to content</a>
  <Header />
  <main id="main">
    <Hero view={view} />
    <Glimpses course={course} />
    {showCurriculum && <Curriculum view={view} />}
    {view.hasBatches && <Batches view={view} />}
    {showTeacher && <Teacher teacher={course.teacher} />}
    {(details.forWho.length > 0 || view.hasLessons || view.hasBatches) && <ForWho view={view} />}
    <Pricing view={view} />
    {
      !course.isDemo && (
        <p class="container booking-note" role="note">
          Online booking opens soon.{" "}
          <a href={whatsappLink(`Hi ${view.teacherFirstName}, I would like to join the ${course.title}.`)} target="_blank" rel="noopener">
            Message us on WhatsApp
          </a>{" "}
          to book your seat today.
        </p>
      )
    }
    {details.faqs.length > 0 && <Faq course={course} />}
    <FinalCta view={view} />
    {course.isDemo && <Checkout />}
  </main>
  <EnrollBar view={view} />
  <Footer />
</Base>

<style is:global>
  /* In-page links (See all lessons, Enroll without JS) glide instead of jumping. */
  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
  }
</style>

<style>
  .booking-note {
    margin-block: var(--space-5);
    color: var(--text-body);
    text-align: center;
  }
</style>
