---
// The frame of /thank-you and /payment-failed: the logo back to the course page, one centred
// column for the message, and the studio's phone number underneath. Each page fills the slot.
import { getImage } from "astro:assets";
import Base from "../../layouts/Base.astro";
import logo from "../../assets/brand/logo.webp";
import { site } from "../../data/site";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
// The logo as a CSS mask, so it shows in the brand's maroon (as on the landing page and main site).
const mask = await getImage({ src: logo, width: 360, format: "webp", quality: 80 });
---

<Base title={title} description={description}>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="rp-header">
    <div class="container-narrow">
      <a class="rp-home" href="/" aria-label={`${site.name}: back to the course page`}>
        <span class="rp-logo" style={`--logo-url: url(${mask.src}); aspect-ratio: ${logo.width} / ${logo.height};`}></span>
      </a>
    </div>
  </header>
  <main id="main" class="rp-main" tabindex="-1">
    <div class="container-narrow rp-column">
      <slot />
    </div>
  </main>
  <footer class="rp-footer">
    <div class="container-narrow">
      <p class="small muted">
        {site.name}, {site.address.city}. Questions? Call <a href={`tel:${site.phone.tel}`}>{site.phone.display}</a>.
      </p>
    </div>
  </footer>
</Base>

<style>
  .rp-header {
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--border);
  }

  .rp-home {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  .rp-logo {
    display: block;
    width: 8.75rem;
    background-color: var(--maroon-800);
    -webkit-mask: var(--logo-url) center / contain no-repeat;
    mask: var(--logo-url) center / contain no-repeat;
  }

  @media (forced-colors: active) {
    .rp-logo {
      forced-color-adjust: none;
      background-color: CanvasText;
    }
  }

  .rp-main {
    padding-block: var(--section-y-tight);
  }

  .rp-main:focus {
    outline: none;
  }

  .rp-column {
    display: grid;
    gap: var(--space-6);
    max-width: 36rem;
  }

  .rp-footer {
    padding-block: var(--space-6);
    border-top: 1px solid var(--border);
  }

  /* No phone booking bar on these pages, so no room is kept for one. */
  @media (max-width: 47.99rem) {
    :global(body:has(.rp-main)) {
      padding-bottom: 0;
    }
  }
</style>
