# Cloudflare Pages headers.
# Content-Security-Policy: not written here. scripts/csp.mjs (the last step of `npm run build`)
# hashes every inline script and adds the policy to this rule in dist/_headers.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000
  # Search: each page decides with <meta name="robots"> (src/lib/seo.ts: demo content and preview
  # builds are noindex). Preview hosts (*.pages.dev) also get X-Robots-Tag from
  # functions/_lib/hosts.ts, which adds these headers to every response that passes through Functions.

# Hashed build assets never change, so cache them for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The course area is personal: never cache it in shared caches.
/learn*
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, nofollow

# Personal and operational pages never appear in search. (X-Frame-Options: DENY for these is set
# by functions/_lib/hosts.ts: a second value here would be joined to the /* one and break both.)
/admin*
  X-Robots-Tag: noindex, nofollow
/thank-you*
  X-Robots-Tag: noindex
/payment-failed*
  X-Robots-Tag: noindex

# Build manifests: always revalidate (the admin polls build.json after a publish).
/build.json
  Cache-Control: no-cache
/domains.json
  Cache-Control: no-cache
/sitemap.xml
  Cache-Control: public, max-age=3600
